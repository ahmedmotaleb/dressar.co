{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
{{ 'dsr-collection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }

    {%- comment -%} Dressar compact mobile header (docs/stages/collection-header.md). {%- endcomment -%}
    #shopify-section-{{ section.id }} {
      --dsr-ch-title-size: {{ section.settings.mobile_title_size | default: 22 }}px;
      --dsr-ch-lines: {{ section.settings.mobile_description_lines | default: 3 }};
      --dsr-ch-top: {{ section.settings.mobile_top_padding | default: 12 }}px;
      --dsr-ch-bottom: {{ section.settings.mobile_bottom_spacing | default: 20 }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  capture dsr_dir
    render 'dsr-direction'
  endcapture
  # A title written in two languages ("Back to University | لبس الجامعة"):
  # phones show only the part in the page's language. The whole title stays
  # in the heading (search engines, desktop). Arabic text is told apart by
  # its UTF-8 lead bytes (U+0600–U+06FF).
  assign dsr_title_parts = collection.title | split: ' | '
  assign dsr_title_split = false
  if dsr_title_parts.size == 2
    assign dsr_arabic_parts = 0
    for part in dsr_title_parts
      assign encoded = part | url_encode
      if encoded contains '%D8' or encoded contains '%D9' or encoded contains '%DA' or encoded contains '%DB'
        assign dsr_arabic_parts = dsr_arabic_parts | plus: 1
      endif
    endfor
    if dsr_arabic_parts == 1
      assign dsr_title_split = true
    endif
  endif
-%}

<div class="collection-hero dsr-collection-hero--compact-mobile{% unless section.settings.breadcrumbs_mobile %} dsr-collection-hero--no-mobile-breadcrumbs{% endunless %} dsr-collection-hero--title-{{ section.settings.title_alignment }} dsr-collection-hero--description-{{ section.settings.description_alignment }}{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      {%- if section.settings.show_breadcrumbs -%}
        {% render 'dsr-breadcrumbs' %}
      {%- endif -%}
      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {%- if dsr_title_split -%}
          {%- for part in dsr_title_parts -%}
            {%- liquid
              assign encoded = part | url_encode
              assign is_arabic = false
              if encoded contains '%D8' or encoded contains '%D9' or encoded contains '%DA' or encoded contains '%DB'
                assign is_arabic = true
              endif
              assign is_current = false
              if is_arabic and dsr_dir == 'rtl'
                assign is_current = true
              elsif is_arabic == false and dsr_dir != 'rtl'
                assign is_current = true
              endif
            -%}
            {%- unless forloop.first -%}<span class="dsr-title-sep"> | </span>{%- endunless -%}
            <span class="dsr-title-part{% unless is_current %} dsr-title-part--other{% endunless %}" dir="{% if is_arabic %}rtl{% else %}ltr{% endif %}">
              {{- part | escape -}}
            </span>
          {%- endfor -%}
        {%- else -%}
          {{- collection.title | escape -}}
        {%- endif -%}
      </h1>

      {%- if section.settings.show_collection_description and collection.description != blank -%}
        {%- comment -%}
          Dressar: long descriptions open collapsed to a few lines behind
          "Read more", so the products start higher on phones. Without
          JavaScript the whole description shows.
        {%- endcomment -%}
        <dsr-read-more class="dsr-read-more">
          <div class="collection-hero__description rte" id="CollectionDescription-{{ section.id }}">
            {{- collection.description -}}
          </div>
          <button
            type="button"
            class="dsr-read-more__toggle link link--text"
            aria-controls="CollectionDescription-{{ section.id }}"
            aria-expanded="false"
            data-label-more="{{ 'dressar.collection.read_more' | t | escape }}"
            data-label-less="{{ 'dressar.collection.read_less' | t | escape }}"
            hidden
          >
            {{- 'dressar.collection.read_more' | t -}}
          </button>
        </dsr-read-more>
        <script>
          if (!customElements.get('dsr-read-more')) {
            customElements.define(
              'dsr-read-more',
              class extends HTMLElement {
                connectedCallback() {
                  this.content = this.querySelector('.collection-hero__description');
                  this.toggle = this.querySelector('.dsr-read-more__toggle');
                  if (!this.content || !this.toggle) return;
                  this.onClick = () => {
                    const open = this.toggle.getAttribute('aria-expanded') === 'true';
                    this.toggle.setAttribute('aria-expanded', String(!open));
                    this.toggleAttribute('data-collapsed', open);
                    this.toggle.textContent = open ? this.toggle.dataset.labelMore : this.toggle.dataset.labelLess;
                  };
                  this.toggle.addEventListener('click', this.onClick);
                  // The number of lines shown differs on phones, so check again when the width changes.
                  this.measure = () => {
                    if (this.toggle.getAttribute('aria-expanded') === 'true') return;
                    this.setAttribute('data-collapsed', '');
                    const clipped = this.content.scrollHeight > this.content.clientHeight + 1;
                    this.toggleAttribute('data-collapsed', clipped);
                    this.toggle.hidden = !clipped;
                  };
                  this.measure();
                  this.observer = new ResizeObserver(() => this.measure());
                  this.observer.observe(this);
                }
                disconnectedCallback() {
                  if (this.observer) this.observer.disconnect();
                  if (this.toggle && this.onClick) this.toggle.removeEventListener('click', this.onClick);
                }
              }
            );
          }
        </script>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media gradient">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "default": true,
      "label": "Show breadcrumbs",
      "info": "Home > collection, with breadcrumb structured data for search engines."
    },
    {
      "type": "header",
      "content": "Mobile",
      "info": "Below 750px. Desktop keeps the settings above."
    },
    {
      "type": "checkbox",
      "id": "breadcrumbs_mobile",
      "label": "Show breadcrumbs on mobile",
      "info": "When hidden, the breadcrumb structured data stays in the page for search engines.",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Title size",
      "min": 18,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "mobile_description_lines",
      "label": "Description lines before \"Read more\"",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_top_padding",
      "label": "Space above the title",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_bottom_spacing",
      "label": "Space before the filters",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Collection title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "description_alignment",
      "label": "Collection description alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
