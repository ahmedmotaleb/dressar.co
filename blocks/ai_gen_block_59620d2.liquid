{% doc %}
  @prompt
    Add a "View All" button below the product grid in the Featured collection block. The button should link to the selected collection's URL, be centered, styled to match a premium minimal brand aesthetic, and work on both mobile and desktop., add price coloe and save +percentage , make phor on same line , allow carousel , make phot ratio adaptor make price with color , control the sze of save + percent to be just percent + add view all , make view all buttom more adjusted not too low , make save + percentage with option of position on top left or right or down and make an option to put just percent without word (save ) make pirice font more bold and make color and size varaiant under product swatch between them with edit to color and font and border
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    width: 100%;
    display: block;
  }

  .ai-featured-collection__container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-featured-collection__header-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-featured-collection__title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-featured-collection__carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .ai-featured-collection__carousel-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.grid_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-featured-collection__carousel-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-featured-collection__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: 20px;
  }

  .ai-featured-collection__product-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    min-width: calc((100% - ({{ block.settings.grid_gap }}px * ({{ block.settings.columns_desktop }} - 1))) / {{ block.settings.columns_desktop }});
  }

  .ai-featured-collection__product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin-bottom: 12px;
    overflow: hidden;
  }

  .ai-featured-collection__product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: {{ block.settings.image_ratio }};
  }

  .ai-featured-collection__product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-collection__product-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-collection__save-badge-{{ ai_gen_id }} {
    position: absolute;
    font-size: {{ block.settings.save_badge_size }}px;
    color: {{ block.settings.save_badge_text_color }};
    background-color: {{ block.settings.save_badge_background }};
    padding: 4px 8px;
    border-radius: {{ block.settings.save_badge_radius }}px;
    font-weight: 600;
    z-index: 1;
  }

  .ai-featured-collection__save-badge-{{ ai_gen_id }}--top-left {
    top: 8px;
    left: 8px;
  }

  .ai-featured-collection__save-badge-{{ ai_gen_id }}--top-right {
    top: 8px;
    right: 8px;
  }

  .ai-featured-collection__save-badge-{{ ai_gen_id }}--bottom-left {
    bottom: 8px;
    left: 8px;
  }

  .ai-featured-collection__save-badge-{{ ai_gen_id }}--bottom-right {
    bottom: 8px;
    right: 8px;
  }

  .ai-featured-collection__product-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-featured-collection__product-title-{{ ai_gen_id }} {
    font-size: 14px;
    margin: 0;
    color: {{ block.settings.text_color }};
    line-height: 1.4;
  }

  .ai-featured-collection__product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-featured-collection__price-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-featured-collection__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: {{ block.settings.price_font_weight }};
  }

  .ai-featured-collection__compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size | times: 0.9 }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-featured-collection__variants-{{ ai_gen_id }} {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .ai-featured-collection__color-swatch-{{ ai_gen_id }} {
    width: {{ block.settings.swatch_size }}px;
    height: {{ block.settings.swatch_size }}px;
    border-radius: {{ block.settings.swatch_border_radius }}px;
    border: {{ block.settings.swatch_border_width }}px solid {{ block.settings.swatch_border_color }};
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .ai-featured-collection__color-swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-featured-collection__size-option-{{ ai_gen_id }} {
    padding: 4px 8px;
    font-size: {{ block.settings.size_font_size }}px;
    color: {{ block.settings.size_text_color }};
    background-color: {{ block.settings.size_background }};
    border: {{ block.settings.size_border_width }}px solid {{ block.settings.size_border_color }};
    border-radius: {{ block.settings.size_border_radius }}px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ai-featured-collection__size-option-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.size_hover_background }};
    color: {{ block.settings.size_hover_text_color }};
  }

  .ai-featured-collection__carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .ai-featured-collection__carousel-nav-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-featured-collection__carousel-nav-{{ ai_gen_id }}--prev {
    left: 10px;
  }

  .ai-featured-collection__carousel-nav-{{ ai_gen_id }}--next {
    right: 10px;
  }

  .ai-featured-collection__carousel-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-featured-collection__view-all-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: 20px;
  }

  .ai-featured-collection__view-all-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-featured-collection__view-all-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-featured-collection__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-featured-collection__product-card-{{ ai_gen_id }} {
      min-width: calc((100% - ({{ block.settings.grid_gap }}px * ({{ block.settings.columns_mobile }} - 1))) / {{ block.settings.columns_mobile }});
    }

    .ai-featured-collection__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-featured-collection__carousel-nav-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }} class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-featured-collection__header-{{ ai_gen_id }}">
        <h2 class="ai-featured-collection__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    {% if block.settings.collection != blank %}
      {% if block.settings.enable_carousel %}
        <div class="ai-featured-collection__carousel-wrapper-{{ ai_gen_id }}">
          {% if block.settings.show_nav_buttons %}
            <button
              class="ai-featured-collection__carousel-nav-{{ ai_gen_id }} ai-featured-collection__carousel-nav-{{ ai_gen_id }}--prev"
              aria-label="Previous"
              data-carousel-prev
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          {% endif %}

          <div class="ai-featured-collection__carousel-{{ ai_gen_id }}" data-carousel>
            {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
              <div class="ai-featured-collection__product-card-{{ ai_gen_id }}">
                <div class="ai-featured-collection__product-image-wrapper-{{ ai_gen_id }}">
                  <a href="{{ product.url }}">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        class="ai-featured-collection__product-image-{{ ai_gen_id }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% else %}
                      <div class="ai-featured-collection__product-image-placeholder-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </a>
                  {% if product.compare_at_price > product.price and block.settings.show_save_badge %}
                    {% assign savings = product.compare_at_price | minus: product.price %}
                    {% assign savings_percent = savings | times: 100.0 | divided_by: product.compare_at_price | round %}
                    <div class="ai-featured-collection__save-badge-{{ ai_gen_id }} ai-featured-collection__save-badge-{{ ai_gen_id }}--{{ block.settings.badge_position }}">
                      {% if block.settings.show_save_text %}Save {% endif %}{{ savings_percent }}%
                    </div>
                  {% endif %}
                </div>
                <div class="ai-featured-collection__product-info-{{ ai_gen_id }}">
                  <h3 class="ai-featured-collection__product-title-{{ ai_gen_id }}">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h3>
                  <div class="ai-featured-collection__price-wrapper-{{ ai_gen_id }}">
                    <span class="ai-featured-collection__product-price-{{ ai_gen_id }}">
                      {{ product.price | money }}
                    </span>
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-featured-collection__compare-price-{{ ai_gen_id }}">
                        {{ product.compare_at_price | money }}
                      </span>
                    {% endif %}
                  </div>
                  {% if block.settings.show_variants %}
                    <div class="ai-featured-collection__variants-{{ ai_gen_id }}">
                      {% if block.settings.show_color_swatches %}
                        {% assign color_option = product.options_with_values | where: 'name', 'Color' | first %}
                        {% if color_option %}
                          {% for value in color_option.values limit: 5 %}
                            <span
                              class="ai-featured-collection__color-swatch-{{ ai_gen_id }}"
                              style="background-color: {{ value | handle }};"
                              title="{{ value }}"
                            ></span>
                          {% endfor %}
                        {% endif %}
                      {% endif %}
                      {% if block.settings.show_size_options %}
                        {% assign size_option = product.options_with_values | where: 'name', 'Size' | first %}
                        {% if size_option %}
                          {% for value in size_option.values limit: 5 %}
                            <span class="ai-featured-collection__size-option-{{ ai_gen_id }}">
                              {{ value }}
                            </span>
                          {% endfor %}
                        {% endif %}
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>

          {% if block.settings.show_nav_buttons %}
            <button
              class="ai-featured-collection__carousel-nav-{{ ai_gen_id }} ai-featured-collection__carousel-nav-{{ ai_gen_id }}--next"
              aria-label="Next"
              data-carousel-next
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          {% endif %}
        </div>
      {% else %}
        <div class="ai-featured-collection__grid-{{ ai_gen_id }}">
          {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
            <div class="ai-featured-collection__product-card-{{ ai_gen_id }}">
              <div class="ai-featured-collection__product-image-wrapper-{{ ai_gen_id }}">
                <a href="{{ product.url }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-featured-collection__product-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    <div class="ai-featured-collection__product-image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </a>
                {% if product.compare_at_price > product.price and block.settings.show_save_badge %}
                  {% assign savings = product.compare_at_price | minus: product.price %}
                  {% assign savings_percent = savings | times: 100.0 | divided_by: product.compare_at_price | round %}
                  <div class="ai-featured-collection__save-badge-{{ ai_gen_id }} ai-featured-collection__save-badge-{{ ai_gen_id }}--{{ block.settings.badge_position }}">
                    {% if block.settings.show_save_text %}Save {% endif %}{{ savings_percent }}%
                  </div>
                {% endif %}
              </div>
              <div class="ai-featured-collection__product-info-{{ ai_gen_id }}">
                <h3 class="ai-featured-collection__product-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>
                <div class="ai-featured-collection__price-wrapper-{{ ai_gen_id }}">
                  <span class="ai-featured-collection__product-price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </span>
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-featured-collection__compare-price-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>
                {% if block.settings.show_variants %}
                  <div class="ai-featured-collection__variants-{{ ai_gen_id }}">
                    {% if block.settings.show_color_swatches %}
                      {% assign color_option = product.options_with_values | where: 'name', 'Color' | first %}
                      {% if color_option %}
                        {% for value in color_option.values limit: 5 %}
                          <span
                            class="ai-featured-collection__color-swatch-{{ ai_gen_id }}"
                            style="background-color: {{ value | handle }};"
                            title="{{ value }}"
                          ></span>
                        {% endfor %}
                      {% endif %}
                    {% endif %}
                    {% if block.settings.show_size_options %}
                      {% assign size_option = product.options_with_values | where: 'name', 'Size' | first %}
                      {% if size_option %}
                        {% for value in size_option.values limit: 5 %}
                          <span class="ai-featured-collection__size-option-{{ ai_gen_id }}">
                            {{ value }}
                          </span>
                        {% endfor %}
                      {% endif %}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if block.settings.show_view_all %}
        <div class="ai-featured-collection__view-all-wrapper-{{ ai_gen_id }}">
          <a
            href="{{ block.settings.collection.url }}"
            class="ai-featured-collection__view-all-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-featured-collection__empty-state-{{ ai_gen_id }}">
        <p>Select a collection to display products</p>
      </div>
    {% endif %}
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.carousel = null;
        this.prevButton = null;
        this.nextButton = null;
      }

      connectedCallback() {
        this.style.display = 'block';
        this.carousel = this.querySelector('[data-carousel]');
        this.prevButton = this.querySelector('[data-carousel-prev]');
        this.nextButton = this.querySelector('[data-carousel-next]');

        if (this.carousel && this.prevButton && this.nextButton) {
          this.setupCarousel();
        }
      }

      setupCarousel() {
        this.prevButton.addEventListener('click', () => {
          const scrollAmount = this.carousel.offsetWidth * 0.8;
          this.carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });

        this.nextButton.addEventListener('click', () => {
          const scrollAmount = this.carousel.offsetWidth * 0.8;
          this.carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });

        this.carousel.addEventListener('scroll', () => {
          this.updateButtonStates();
        });

        this.updateButtonStates();
      }

      updateButtonStates() {
        const isAtStart = this.carousel.scrollLeft <= 0;
        const isAtEnd = this.carousel.scrollLeft + this.carousel.offsetWidth >= this.carousel.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Featured collection",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable carousel",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_nav_buttons",
      "label": "Show navigation buttons",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Grid gap",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Product images"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1",
          "label": "Square (1:1)"
        },
        {
          "value": "0.75",
          "label": "Portrait (3:4)"
        },
        {
          "value": "1.33",
          "label": "Landscape (4:3)"
        },
        {
          "value": "1.5",
          "label": "Wide (3:2)"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Save badge"
    },
    {
      "type": "checkbox",
      "id": "show_save_badge",
      "label": "Show save badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_save_text",
      "label": "Show 'Save' text",
      "default": false
    },
    {
      "type": "select",
      "id": "badge_position",
      "label": "Badge position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "top-left"
    },
    {
      "type": "range",
      "id": "save_badge_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Badge font size",
      "default": 12
    },
    {
      "type": "range",
      "id": "save_badge_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Badge border radius",
      "default": 4
    },
    {
      "type": "color",
      "id": "save_badge_background",
      "label": "Badge background",
      "default": "#d82c0d"
    },
    {
      "type": "color",
      "id": "save_badge_text_color",
      "label": "Badge text color",
      "default": "#ffffff"
    },
