{% doc %}
  @prompt
    price with different color and color varaint is below every product as circle and all phot must be allign and save + percent and determinte the position
    generate featured collection 
    , add carousel option and add color option for every price and add option variant to choose like color or size and made it in circle
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-featured-collection__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-featured-collection__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-featured-collection__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-featured-collection__carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-featured-collection__grid-{{ ai_gen_id }} {
    display: grid;
    {% if block.settings.enable_carousel %}
      grid-auto-flow: column;
      grid-auto-columns: calc((100% - ({{ block.settings.grid_gap }}px * ({{ block.settings.products_per_row_desktop }} - 1))) / {{ block.settings.products_per_row_desktop }});
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -ms-overflow-style: none;
    {% else %}
      grid-template-columns: repeat({{ block.settings.products_per_row_desktop }}, 1fr);
    {% endif %}
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-featured-collection__grid-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-featured-collection__product-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    {% if block.settings.enable_carousel %}
      scroll-snap-align: start;
    {% endif %}
  }

  .ai-featured-collection__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_ratio }};
    overflow: hidden;
    background-color: #f4f4f4;
    margin-bottom: 12px;
  }

  .ai-featured-collection__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-featured-collection__badge-{{ ai_gen_id }} {
    position: absolute;
    {% if block.settings.badge_position == 'top_left' %}
      top: 10px;
      left: 10px;
    {% elsif block.settings.badge_position == 'top_right' %}
      top: 10px;
      right: 10px;
    {% elsif block.settings.badge_position == 'bottom_left' %}
      bottom: 10px;
      left: 10px;
    {% else %}
      bottom: 10px;
      right: 10px;
    {% endif %}
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: {{ block.settings.badge_radius }}px;
    font-size: 12px;
    font-weight: 600;
    z-index: 2;
  }

  .ai-featured-collection__info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-featured-collection__title-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: {{ block.settings.product_title_color }};
  }

  .ai-featured-collection__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    margin: 0;
    font-weight: 500;
    line-height: 1.3;
  }

  .ai-featured-collection__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-featured-collection__price-regular-{{ ai_gen_id }} {
    color: {{ block.settings.regular_price_color }};
  }

  .ai-featured-collection__compare-price-{{ ai_gen_id }} {
    text-decoration: line-through;
    color: {{ block.settings.compare_price_color }};
    font-size: {{ block.settings.price_size | times: 0.9 }}px;
  }

  .ai-featured-collection__sale-price-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
  }

  .ai-featured-collection__variant-swatches-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .ai-featured-collection__variant-swatch-{{ ai_gen_id }} {
    width: {{ block.settings.swatch_size }}px;
    height: {{ block.settings.swatch_size }}px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.swatch_border_color }};
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.swatch_size | times: 0.4 }}px;
    font-weight: 600;
    overflow: hidden;
  }

  .ai-featured-collection__variant-swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
    border-color: {{ block.settings.swatch_hover_border_color }};
  }

  .ai-featured-collection__carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_bg }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: background-color 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-featured-collection__carousel-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg }};
  }

  .ai-featured-collection__carousel-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-featured-collection__carousel-nav--prev-{{ ai_gen_id }} {
    left: -20px;
  }

  .ai-featured-collection__carousel-nav--next-{{ ai_gen_id }} {
    right: -20px;
  }

  .ai-featured-collection__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  @media screen and (max-width: 989px) {
    .ai-featured-collection__grid-{{ ai_gen_id }} {
      {% if block.settings.enable_carousel %}
        grid-auto-columns: calc((100% - ({{ block.settings.grid_gap }}px * ({{ block.settings.products_per_row_tablet }} - 1))) / {{ block.settings.products_per_row_tablet }});
      {% else %}
        grid-template-columns: repeat({{ block.settings.products_per_row_tablet }}, 1fr);
      {% endif %}
    }

    .ai-featured-collection__carousel-nav-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__grid-{{ ai_gen_id }} {
      {% if block.settings.enable_carousel %}
        grid-auto-columns: calc((100% - ({{ block.settings.grid_gap }}px * ({{ block.settings.products_per_row_mobile }} - 1))) / {{ block.settings.products_per_row_mobile }});
      {% else %}
        grid-template-columns: repeat({{ block.settings.products_per_row_mobile }}, 1fr);
      {% endif %}
    }

    .ai-featured-collection__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-featured-collection__product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }} class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-featured-collection__header-{{ ai_gen_id }}">
        <h2 class="ai-featured-collection__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
      <div class="ai-featured-collection__carousel-wrapper-{{ ai_gen_id }}">
        {% if block.settings.enable_carousel %}
          <button
            class="ai-featured-collection__carousel-nav-{{ ai_gen_id }} ai-featured-collection__carousel-nav--prev-{{ ai_gen_id }}"
            aria-label="Previous"
            data-carousel-prev
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            class="ai-featured-collection__carousel-nav-{{ ai_gen_id }} ai-featured-collection__carousel-nav--next-{{ ai_gen_id }}"
            aria-label="Next"
            data-carousel-next
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}

        <div class="ai-featured-collection__grid-{{ ai_gen_id }}" data-carousel-container>
          {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
            <div class="ai-featured-collection__product-card-{{ ai_gen_id }}">
              <div class="ai-featured-collection__image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-featured-collection__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
                  >
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}

                {% if product.compare_at_price > product.price %}
                  {% assign discount_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                  <div class="ai-featured-collection__badge-{{ ai_gen_id }}">
                    Save {{ discount_percent }}%
                  </div>
                {% endif %}
              </div>

              <div class="ai-featured-collection__info-{{ ai_gen_id }}">
                <a href="{{ product.url }}" class="ai-featured-collection__title-link-{{ ai_gen_id }}">
                  <h3 class="ai-featured-collection__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                </a>

                <div class="ai-featured-collection__price-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-featured-collection__compare-price-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                    <span class="ai-featured-collection__sale-price-{{ ai_gen_id }}">
                      {{ product.price | money }}
                    </span>
                  {% else %}
                    <span class="ai-featured-collection__price-regular-{{ ai_gen_id }}">
                      {{ product.price | money }}
                    </span>
                  {% endif %}
                </div>

                {% if block.settings.show_variant_swatches %}
                  {% assign selected_option = null %}
                  {% for option in product.options_with_values %}
                    {% assign option_name_downcase = option.name | downcase %}
                    {% if block.settings.variant_option_type == 'color' %}
                      {% if option_name_downcase == 'color' or option_name_downcase == 'colour' %}
                        {% assign selected_option = option %}
                        {% break %}
                      {% endif %}
                    {% elsif block.settings.variant_option_type == 'size' %}
                      {% if option_name_downcase == 'size' %}
                        {% assign selected_option = option %}
                        {% break %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}

                  {% if selected_option %}
                    <div class="ai-featured-collection__variant-swatches-{{ ai_gen_id }}">
                      {% for value in selected_option.values %}
                        {% assign value_downcase = value | downcase | replace: ' ', '-' %}
                        {% assign swatch_color = null %}

                        {% if block.settings.variant_option_type == 'color' %}
                          {% case value_downcase %}
                            {% when 'black' %}
                              {% assign swatch_color = '#000000' %}
                            {% when 'white' %}
                              {% assign swatch_color = '#FFFFFF' %}
                            {% when 'red' %}
                              {% assign swatch_color = '#FF0000' %}
                            {% when 'blue' %}
                              {% assign swatch_color = '#0000FF' %}
                            {% when 'green' %}
                              {% assign swatch_color = '#008000' %}
                            {% when 'yellow' %}
                              {% assign swatch_color = '#FFFF00' %}
                            {% when 'pink' %}
                              {% assign swatch_color = '#FFC0CB' %}
                            {% when 'purple' %}
                              {% assign swatch_color = '#800080' %}
                            {% when 'orange' %}
                              {% assign swatch_color = '#FFA500' %}
                            {% when 'brown' %}
                              {% assign swatch_color = '#A52A2A' %}
                            {% when 'grey' or 'gray' %}
                              {% assign swatch_color = '#808080' %}
                            {% when 'navy' %}
                              {% assign swatch_color = '#000080' %}
                            {% when 'beige' %}
                              {% assign swatch_color = '#F5F5DC' %}
                            {% when 'gold' %}
                              {% assign swatch_color = '#FFD700' %}
                            {% when 'silver' %}
                              {% assign swatch_color = '#C0C0C0' %}
                            {% else %}
                              {% assign swatch_color = '#CCCCCC' %}
                          {% endcase %}

                          <div
                            class="ai-featured-collection__variant-swatch-{{ ai_gen_id }}"
                            style="background-color: {{ swatch_color }};"
                            title="{{ value }}"
                            data-variant-value="{{ value }}"
                          ></div>
                        {% else %}
                          <div
                            class="ai-featured-collection__variant-swatch-{{ ai_gen_id }}"
                            style="background-color: {{ block.settings.size_swatch_bg }}; color: {{ block.settings.size_swatch_text }};"
                            title="{{ value }}"
                            data-variant-value="{{ value }}"
                          >
                            {{ value | slice: 0, 2 | upcase }}
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="ai-featured-collection__empty-state-{{ ai_gen_id }}">
        <p>Next, select a collection to display products</p>
      </div>
    {% endif %}
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.carouselEnabled = {{ block.settings.enable_carousel | json }};
      }

      connectedCallback() {
        this.swatches = this.querySelectorAll('.ai-featured-collection__variant-swatch-{{ ai_gen_id }}');
        this.setupSwatchListeners();

        if (this.carouselEnabled) {
          this.setupCarousel();
        }
      }

      setupSwatchListeners() {
        this.swatches.forEach((swatch) => {
          swatch.addEventListener('click', function(e) {
            e.preventDefault();
            const productCard = this.closest('.ai-featured-collection__product-card-{{ ai_gen_id }}');
            const productLink = productCard.querySelector('.ai-featured-collection__title-link-{{ ai_gen_id }}');
            if (productLink) {
              window.location.href = productLink.href;
            }
          });
        });
      }

      setupCarousel() {
        this.container = this.querySelector('[data-carousel-container]');
        this.prevButton = this.querySelector('[data-carousel-prev]');
        this.nextButton = this.querySelector('[data-carousel-next]');

        if (!this.container || !this.prevButton || !this.nextButton) return;

        this.prevButton.addEventListener('click', () => this.scrollCarousel('prev'));
        this.nextButton.addEventListener('click', () => this.scrollCarousel('next'));

        this.container.addEventListener('scroll', () => this.updateButtonStates());
        this.updateButtonStates();
      }

      scrollCarousel(direction) {
        const scrollAmount = this.container.offsetWidth;
        const scrollPosition = direction === 'next' 
          ? this.container.scrollLeft + scrollAmount 
          : this.container.scrollLeft - scrollAmount;

        this.container.scrollTo({
          left: scrollPosition,
          behavior: 'smooth'
        });
      }

      updateButtonStates() {
        if (!this.container || !this.prevButton || !this.nextButton) return;

        const isAtStart = this.container.scrollLeft <= 0;
        const isAtEnd = this.container.scrollLeft + this.container.offsetWidth >= this.container.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
