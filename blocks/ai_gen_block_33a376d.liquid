{% doc %}
  @prompt
    Create a transparent/overlay header that sits on top of the hero or slideshow section below it. The header background should be fully transparent by default, with the logo and navigation links visible in white or light color. When the user scrolls down, the header should transition to a solid background color (matching the theme's header color scheme) with a smooth fade effect. The header should remain sticky/fixed at the top while scrolling.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-transparent-header-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: background-color {{ block.settings.transition_speed }}ms ease, box-shadow {{ block.settings.transition_speed }}ms ease;
    width: 100%;
    display: block;
  }

  .ai-transparent-header-{{ ai_gen_id }}.scrolled {
    background-color: {{ block.settings.scrolled_bg_color }};
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
  }

  .ai-transparent-header-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: padding {{ block.settings.transition_speed }}ms ease;
  }

  .ai-transparent-header-{{ ai_gen_id }}.scrolled .ai-transparent-header-container-{{ ai_gen_id }} {
    padding: {{ block.settings.scrolled_padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-transparent-header-logo-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity {{ block.settings.transition_speed }}ms ease;
  }

  .ai-transparent-header-logo-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-transparent-header-logo-image-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
    display: block;
    transition: max-width {{ block.settings.transition_speed }}ms ease;
  }

  .ai-transparent-header-{{ ai_gen_id }}.scrolled .ai-transparent-header-logo-image-{{ ai_gen_id }} {
    max-width: {{ block.settings.scrolled_logo_width }}px;
  }

  .ai-transparent-header-logo-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.logo_text_size }}px;
    font-weight: 600;
    color: {{ block.settings.transparent_text_color }};
    transition: color {{ block.settings.transition_speed }}ms ease, font-size {{ block.settings.transition_speed }}ms ease;
  }

  .ai-transparent-header-{{ ai_gen_id }}.scrolled .ai-transparent-header-logo-text-{{ ai_gen_id }} {
    color: {{ block.settings.scrolled_text_color }};
    font-size: {{ block.settings.scrolled_logo_text_size }}px;
  }

  .ai-transparent-header-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.nav_spacing }}px;
  }

  .ai-transparent-header-nav-link-{{ ai_gen_id }} {
    color: {{ block.settings.transparent_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.nav_font_size }}px;
    font-weight: 500;
    transition: color {{ block.settings.transition_speed }}ms ease, opacity {{ block.settings.transition_speed }}ms ease;
    padding: 8px 12px;
  }

  .ai-transparent-header-{{ ai_gen_id }}.scrolled .ai-transparent-header-nav-link-{{ ai_gen_id }} {
    color: {{ block.settings.scrolled_text_color }};
  }

  .ai-transparent-header-nav-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-transparent-header-mobile-toggle-{{ ai_gen_id }} {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.transparent_text_color }};
    transition: color {{ block.settings.transition_speed }}ms ease;
  }

  .ai-transparent-header-{{ ai_gen_id }}.scrolled .ai-transparent-header-mobile-toggle-{{ ai_gen_id }} {
    color: {{ block.settings.scrolled_text_color }};
  }

  .ai-transparent-header-mobile-toggle-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-transparent-header-mobile-toggle-{{ ai_gen_id }} {
      display: block;
    }

    .ai-transparent-header-nav-{{ ai_gen_id }} {
      position: fixed;
      top: 0;
      right: -100%;
      width: 280px;
      height: 100vh;
      background-color: {{ block.settings.mobile_menu_bg_color }};
      flex-direction: column;
      align-items: flex-start;
      padding: 80px 30px 30px;
      gap: 0;
      transition: right {{ block.settings.transition_speed }}ms ease;
      box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
      overflow-y: auto;
    }

    .ai-transparent-header-nav-{{ ai_gen_id }}.active {
      right: 0;
    }

    .ai-transparent-header-nav-link-{{ ai_gen_id }} {
      width: 100%;
      padding: 16px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
      color: {{ block.settings.mobile_menu_text_color }};
    }

    .ai-transparent-header-mobile-close-{{ ai_gen_id }} {
      position: absolute;
      top: 20px;
      right: 20px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      color: {{ block.settings.mobile_menu_text_color }};
    }

    .ai-transparent-header-mobile-close-{{ ai_gen_id }} svg {
      width: 24px;
      height: 24px;
      display: block;
    }

    .ai-transparent-header-overlay-{{ ai_gen_id }} {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      background-color: rgba(0, 0, 0, 0.5);
      opacity: 0;
      visibility: hidden;
      transition: opacity {{ block.settings.transition_speed }}ms ease, visibility {{ block.settings.transition_speed }}ms ease;
      z-index: 999;
    }

    .ai-transparent-header-overlay-{{ ai_gen_id }}.active {
      opacity: 1;
      visibility: visible;
    }
  }
{% endstyle %}

<transparent-header-{{ ai_gen_id }}
  class="ai-transparent-header-{{ ai_gen_id }}"
  data-scroll-threshold="{{ block.settings.scroll_threshold }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-transparent-header-container-{{ ai_gen_id }}">
    <a href="/" class="ai-transparent-header-logo-{{ ai_gen_id }}">
      {% if block.settings.logo != blank %}
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          class="ai-transparent-header-logo-image-{{ ai_gen_id }}"
          width="{{ block.settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      {% else %}
        <span class="ai-transparent-header-logo-text-{{ ai_gen_id }}">
          {{ block.settings.logo_text | default: shop.name }}
        </span>
      {% endif %}
    </a>

    <button
      class="ai-transparent-header-mobile-toggle-{{ ai_gen_id }}"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <nav class="ai-transparent-header-nav-{{ ai_gen_id }}">
      <button
        class="ai-transparent-header-mobile-close-{{ ai_gen_id }}"
        aria-label="Close menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      {% if block.settings.nav_link_1_text != blank %}
        <a href="{{ block.settings.nav_link_1_url }}" class="ai-transparent-header-nav-link-{{ ai_gen_id }}">
          {{ block.settings.nav_link_1_text }}
        </a>
      {% endif %}

      {% if block.settings.nav_link_2_text != blank %}
        <a href="{{ block.settings.nav_link_2_url }}" class="ai-transparent-header-nav-link-{{ ai_gen_id }}">
          {{ block.settings.nav_link_2_text }}
        </a>
      {% endif %}

      {% if block.settings.nav_link_3_text != blank %}
        <a href="{{ block.settings.nav_link_3_url }}" class="ai-transparent-header-nav-link-{{ ai_gen_id }}">
          {{ block.settings.nav_link_3_text }}
        </a>
      {% endif %}

      {% if block.settings.nav_link_4_text != blank %}
        <a href="{{ block.settings.nav_link_4_url }}" class="ai-transparent-header-nav-link-{{ ai_gen_id }}">
          {{ block.settings.nav_link_4_text }}
        </a>
      {% endif %}

      {% if block.settings.nav_link_5_text != blank %}
        <a href="{{ block.settings.nav_link_5_url }}" class="ai-transparent-header-nav-link-{{ ai_gen_id }}">
          {{ block.settings.nav_link_5_text }}
        </a>
      {% endif %}
    </nav>
  </div>

  <div class="ai-transparent-header-overlay-{{ ai_gen_id }}"></div>
</transparent-header-{{ ai_gen_id }}>

<script>
  (function() {
    class TransparentHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollThreshold = parseInt(this.dataset.scrollThreshold) || 50;
        this.mobileToggle = this.querySelector('.ai-transparent-header-mobile-toggle-{{ ai_gen_id }}');
        this.mobileClose = this.querySelector('.ai-transparent-header-mobile-close-{{ ai_gen_id }}');
        this.nav = this.querySelector('.ai-transparent-header-nav-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-transparent-header-overlay-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.handleScroll();
        window.addEventListener('scroll', this.handleScroll.bind(this));
        
        if (this.mobileToggle) {
          this.mobileToggle.addEventListener('click', this.openMobileMenu.bind(this));
        }
        
        if (this.mobileClose) {
          this.mobileClose.addEventListener('click', this.closeMobileMenu.bind(this));
        }
        
        if (this.overlay) {
          this.overlay.addEventListener('click', this.closeMobileMenu.bind(this));
        }
      }

      handleScroll() {
        if (window.scrollY > this.scrollThreshold) {
          this.classList.add('scrolled');
        } else {
          this.classList.remove('scrolled');
        }
      }

      openMobileMenu() {
        this.nav.classList.add('active');
        this.overlay.classList.add('active');
        this.mobileToggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      closeMobileMenu() {
        this.nav.classList.remove('active');
        this.overlay.classList.remove('active');
        this.mobileToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.handleScroll.bind(this));
      }
    }

    customElements.define('transparent-header-{{ ai_gen_id }}', TransparentHeader{{ ai_gen_id }});
  })();
</script>

