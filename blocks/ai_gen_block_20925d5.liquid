{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-magazine-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-magazine-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-magazine-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.item_border_radius }}px;
    background-color: {{ block.settings.item_background_color }};
  }

  .ai-magazine-item-{{ ai_gen_id }}--featured {
    grid-column: span 8;
    grid-row: span 2;
  }

  .ai-magazine-item-{{ ai_gen_id }}--secondary {
    grid-column: span 4;
  }

  .ai-magazine-item-{{ ai_gen_id }}--tertiary {
    grid-column: span 4;
  }

  .ai-magazine-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 75%;
    overflow: hidden;
  }

  .ai-magazine-item-{{ ai_gen_id }}--featured .ai-magazine-image-wrapper-{{ ai_gen_id }} {
    padding-bottom: 100%;
  }

  .ai-magazine-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-magazine-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
    color: {{ block.settings.text_color }};
  }

  .ai-magazine-category-{{ ai_gen_id }} {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    color: {{ block.settings.category_color }};
  }

  .ai-magazine-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
  }

  .ai-magazine-item-{{ ai_gen_id }}--featured .ai-magazine-title-{{ ai_gen_id }} {
    font-size: calc({{ block.settings.title_size }}px * 1.5);
  }

  .ai-magazine-excerpt-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.9;
  }

  .ai-magazine-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-magazine-author-{{ ai_gen_id }},
  .ai-magazine-date-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .ai-magazine-link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  @media screen and (max-width: 989px) {
    .ai-magazine-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(6, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-magazine-item-{{ ai_gen_id }}--featured {
      grid-column: span 6;
      grid-row: span 1;
    }

    .ai-magazine-item-{{ ai_gen_id }}--secondary {
      grid-column: span 6;
    }

    .ai-magazine-item-{{ ai_gen_id }}--tertiary {
      grid-column: span 6;
    }

    .ai-magazine-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.9);
    }

    .ai-magazine-item-{{ ai_gen_id }}--featured .ai-magazine-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 1.2);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-magazine-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.grid_gap | times: 0.5 }}px;
    }

    .ai-magazine-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.75 }}px;
    }

    .ai-magazine-excerpt-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<magazine-layout-{{ ai_gen_id }} class="ai-magazine-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-magazine-grid-{{ ai_gen_id }}">
    {% if block.settings.article_1 != blank %}
      <article class="ai-magazine-item-{{ ai_gen_id }} ai-magazine-item-{{ ai_gen_id }}--featured">
        <div class="ai-magazine-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.article_1.image %}
            <img
              src="{{ block.settings.article_1.image | image_url: width: 1200 }}"
              alt="{{ block.settings.article_1.image.alt | escape }}"
              class="ai-magazine-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.article_1.image.width }}"
              height="{{ block.settings.article_1.image.height }}"
            >
          {% else %}
            <div class="ai-magazine-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-magazine-content-{{ ai_gen_id }}">
          {% if block.settings.show_category and block.settings.article_1.tags.size > 0 %}
            <span class="ai-magazine-category-{{ ai_gen_id }}">{{ block.settings.article_1.tags.first }}</span>
          {% endif %}
          <h3 class="ai-magazine-title-{{ ai_gen_id }}">{{ block.settings.article_1.title }}</h3>
          {% if block.settings.show_excerpt and block.settings.article_1.excerpt != blank %}
            <p class="ai-magazine-excerpt-{{ ai_gen_id }}">{{ block.settings.article_1.excerpt | strip_html | truncate: 120 }}</p>
          {% endif %}
          <div class="ai-magazine-meta-{{ ai_gen_id }}">
            {% if block.settings.show_author %}
              <span class="ai-magazine-author-{{ ai_gen_id }}">{{ block.settings.article_1.author }}</span>
            {% endif %}
            {% if block.settings.show_date %}
              <span class="ai-magazine-date-{{ ai_gen_id }}">{{ block.settings.article_1.published_at | date: '%b %d, %Y' }}</span>
            {% endif %}
          </div>
        </div>
        <a href="{{ block.settings.article_1.url }}" class="ai-magazine-link-{{ ai_gen_id }}" aria-label="{{ block.settings.article_1.title }}"></a>
      </article>
    {% endif %}

