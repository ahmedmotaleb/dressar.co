<script>
  (function() {
    class MagazineLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const links = this.querySelectorAll('.ai-magazine-link-{{ ai_gen_id }}');
        links.forEach(link => {
          link.addEventListener('focus', () => {
            link.closest('.ai-magazine-item-{{ ai_gen_id }}').style.outline = '2px solid currentColor';
          });
          link.addEventListener('blur', () => {
            link.closest('.ai-magazine-item-{{ ai_gen_id }}').style.outline = 'none';
          });
        });
      }
    }

    customElements.define('magazine-layout-{{ ai_gen_id }}', MagazineLayout{{ ai_gen_id }});
  })();
</script>

