{% doc %}
  @prompt
    icons with texts
{% enddoc %}
{%- comment -%}
  Store benefits ("Icons with text"). Cards come from the nested "Benefit"
  blocks (blocks/_dsr-benefit.liquid) when the merchant has added any: they
  can be added, removed and reordered in the theme editor. Otherwise the
  block's own six item slots are shown, as configured before.
  Below 750px, "Compact cards on mobile" draws them as a 2-column grid of
  small white cards (docs/stages/store-benefits.md); desktop is unchanged.
{%- endcomment -%}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-text-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-icon-text-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.spacing }}px;
    max-width: 100%;
  }

  .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit {
    display: flex;
    flex-direction: {{ block.settings.layout }};
    align-items: {{ block.settings.alignment }};
    text-align: {% if block.settings.alignment == 'center' %}center{% elsif block.settings.alignment == 'flex-end' %}right{% else %}left{% endif %};
    gap: {{ block.settings.icon_text_gap }}px;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__icon {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__icon svg {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
    color: {{ block.settings.icon_color }};
  }

  .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__content {
    flex: 1;
  }

  .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__title {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
  }

  .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__text {
    margin: 0;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-icon-text-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit {
      {% if block.settings.stack_on_mobile %}
        flex-direction: column;
        align-items: center;
        text-align: center;
      {% endif %}
    }

    {%- if block.settings.mobile_cards %}
      /* Compact cards: 2 columns, equal heights per row, small white cards. */
      .ai-icon-text-container-{{ ai_gen_id }} {
        box-sizing: border-box;
        width: 100%;
        margin-block: {{ block.settings.mobile_outer_spacing }}px;
        padding: {{ block.settings.mobile_section_padding }}px;
        background-color: {{ block.settings.mobile_section_background }};
      }

      .ai-icon-text-grid-{{ ai_gen_id }} {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: stretch;
        gap: {{ block.settings.mobile_gap }}px;
      }

      .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit {
        box-sizing: border-box;
        min-width: 0;
        min-height: 0;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
        padding: {{ block.settings.mobile_card_padding }}px;
        text-align: center;
        background-color: {{ block.settings.mobile_card_background }};
        border-radius: {{ block.settings.mobile_card_radius }}px;
        box-shadow: none;
      }

      .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__icon,
      .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__icon svg {
        width: 24px;
        height: 24px;
      }

      .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__icon {
        background-color: transparent;
        border-radius: 0;
      }

      .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__content {
        flex: 0 1 auto;
        min-width: 0;
      }

      .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__title {
        margin: 0 0 5px;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.35;
        letter-spacing: 0;
        overflow-wrap: anywhere;
      }

      .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__text {
        font-size: 11px;
        font-weight: 400;
        line-height: 1.45;
        letter-spacing: 0;
        overflow-wrap: anywhere;
      }

      /* Arabic letters in Cairo, like the product cards (theme setting "Cairo for Arabic"). */
      .dsr-arabic-font .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__title,
      .dsr-arabic-font .ai-icon-text-grid-{{ ai_gen_id }} .dsr-benefit__text {
        font-family: var(--dsr-font-arabic-body, inherit);
      }
    {%- endif %}
  }
{% endstyle %}

{%- capture dsr_benefit_blocks -%}{% content_for 'blocks' %}{%- endcapture -%}

<icon-text-block-{{ ai_gen_id }} class="ai-icon-text-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-text-grid-{{ ai_gen_id }}">
    {%- if dsr_benefit_blocks != blank -%}
      {{ dsr_benefit_blocks }}
    {%- else -%}
      {%- for i in (1..6) -%}
        {%- liquid
          assign icon_key = 'icon_' | append: i
          assign title_key = 'title_' | append: i
          assign description_key = 'description_' | append: i
          assign enabled_key = 'item_' | append: i | append: '_enabled'
        -%}
        {%- if block.settings[enabled_key] -%}
          {%- render 'dsr-benefit', icon: block.settings[icon_key], title: block.settings[title_key], description: block.settings[description_key] -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</icon-text-block-{{ ai_gen_id }}>

<script>
  (function() {
    if (customElements.get('icon-text-block-{{ ai_gen_id }}')) return;
    class IconTextBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('icon-text-block-{{ ai_gen_id }}', IconTextBlock{{ ai_gen_id }});
  })();
</script>

