{% doc %}
  @prompt
    Add color variant swatches displayed under every product card in the product grid and collection pages. Each swatch should show a small colored circle for each available color variant of the product. Clicking a swatch should update the product card to reflect that color variant (image and link). Only show color swatches, not other variant types like size.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-color-swatches-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-color-swatches__container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.swatch_spacing }}px;
    margin-top: {{ block.settings.top_spacing }}px;
    justify-content: {{ block.settings.alignment }};
  }

  .ai-color-swatches__swatch-{{ ai_gen_id }} {
    width: {{ block.settings.swatch_size }}px;
    height: {{ block.settings.swatch_size }}px;
    border-radius: {{ block.settings.swatch_border_radius }}%;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .ai-color-swatches__swatch-{{ ai_gen_id }}:hover {
    transform: scale({{ block.settings.hover_scale }});
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-color-swatches__swatch-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.active_border_color }};
    border-width: {{ block.settings.active_border_thickness }}px;
    box-shadow: 0 0 0 1px {{ block.settings.active_border_color }};
  }

  .ai-color-swatches__swatch-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-color-swatches__swatch-color-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-color-swatches__swatch-{{ ai_gen_id }} {
      width: {{ block.settings.swatch_size | times: 0.85 }}px;
      height: {{ block.settings.swatch_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<color-variant-swatches-{{ ai_gen_id }}
  class="ai-color-swatches-{{ ai_gen_id }}"
  data-product-id="{{ product.id }}"
  data-current-variant-id="{{ product.selected_or_first_available_variant.id }}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign color_option_index = nil
    for option in product.options_with_values
      assign option_name_downcase = option.name | downcase
      if option_name_downcase contains 'color' or option_name_downcase contains 'colour'
        assign color_option_index = option.position
        break
      endif
    endfor
  %}

  {% if color_option_index != nil %}
    <div class="ai-color-swatches__container-{{ ai_gen_id }}">
      {% liquid
        assign color_values = product.options_with_values[color_option_index].values
        assign displayed_colors = ''
      %}

      {% for color_value in color_values %}
        {% liquid
          unless displayed_colors contains color_value
            assign displayed_colors = displayed_colors | append: color_value | append: ','
            
            assign variant_for_color = nil
            for variant in product.variants
              if color_option_index == 1
                assign variant_option = variant.option1
              elsif color_option_index == 2
                assign variant_option = variant.option2
              else
                assign variant_option = variant.option3
              endif
              
              if variant_option == color_value
                assign variant_for_color = variant
                break
              endif
            endfor
            
            if variant_for_color == nil
              continue
            endif
            
            assign is_active = false
            if product.selected_or_first_available_variant.id == variant_for_color.id
              assign is_active = true
            endif
            
            assign swatch_image = variant_for_color.featured_image
            assign color_name_handle = color_value | handleize
            assign color_file_name = 'swatch-' | append: color_name_handle | append: '.png'
            assign color_swatch_file = color_file_name | file_img_url
          endunless
        %}

        <button
          type="button"
          class="ai-color-swatches__swatch-{{ ai_gen_id }} {% if is_active %}active{% endif %}"
          data-variant-id="{{ variant_for_color.id }}"
          data-variant-url="{{ variant_for_color.url }}"
          data-variant-image="{% if swatch_image %}{{ swatch_image | image_url: width: 600 }}{% endif %}"
          data-color-value="{{ color_value | escape }}"
          aria-label="{{ color_value }}"
          title="{{ color_value }}"
        >
          {% if block.settings.swatch_type == 'image' and swatch_image %}
            <img
              src="{{ swatch_image | image_url: width: 100 }}"
              alt="{{ color_value }}"
              class="ai-color-swatches__swatch-image-{{ ai_gen_id }}"
              loading="lazy"
              width="100"
              height="100"
            >
          {% elsif block.settings.swatch_type == 'color' %}
            {% liquid
              assign color_value_downcase = color_value | downcase
              assign swatch_color = '#cccccc'
              
              if color_value_downcase == 'white' or color_value_downcase == 'أبيض'
                assign swatch_color = '#ffffff'
              elsif color_value_downcase == 'black' or color_value_downcase == 'أسود'
                assign swatch_color = '#000000'
              elsif color_value_downcase == 'red' or color_value_downcase == 'أحمر'
                assign swatch_color = '#ff0000'
              elsif color_value_downcase == 'blue' or color_value_downcase == 'أزرق'
                assign swatch_color = '#0000ff'
              elsif color_value_downcase == 'green' or color_value_downcase == 'أخضر'
                assign swatch_color = '#00ff00'
              elsif color_value_downcase == 'yellow' or color_value_downcase == 'أصفر'
                assign swatch_color = '#ffff00'
              elsif color_value_downcase == 'pink' or color_value_downcase == 'وردي'
                assign swatch_color = '#ffc0cb'
              elsif color_value_downcase == 'purple' or color_value_downcase == 'بنفسجي'
                assign swatch_color = '#800080'
              elsif color_value_downcase == 'orange' or color_value_downcase == 'برتقالي'
                assign swatch_color = '#ffa500'
              elsif color_value_downcase == 'brown' or color_value_downcase == 'بني'
                assign swatch_color = '#8b4513'
              elsif color_value_downcase == 'gray' or color_value_downcase == 'grey' or color_value_downcase == 'رمادي'
                assign swatch_color = '#808080'
              elsif color_value_downcase == 'beige' or color_value_downcase == 'بيج'
                assign swatch_color = '#f5f5dc'
              elsif color_value_downcase == 'navy' or color_value_downcase == 'كحلي'
                assign swatch_color = '#000080'
              elsif color_value_downcase == 'maroon' or color_value_downcase == 'عنابي'
                assign swatch_color = '#800000'
              elsif color_value_downcase == 'gold' or color_value_downcase == 'ذهبي'
                assign swatch_color = '#ffd700'
              elsif color_value_downcase == 'silver' or color_value_downcase == 'فضي'
                assign swatch_color = '#c0c0c0'
              endif
            %}
            <span
              class="ai-color-swatches__swatch-color-{{ ai_gen_id }}"
              style="background-color: {{ swatch_color }};"
            ></span>
          {% else %}
            <img
              src="{{ swatch_image | image_url: width: 100 }}"
              alt="{{ color_value }}"
              class="ai-color-swatches__swatch-image-{{ ai_gen_id }}"
              loading="lazy"
              width="100"
              height="100"
            >
          {% endif %}
        </button>
      {% endfor %}
    </div>
  {% endif %}
</color-variant-swatches-{{ ai_gen_id }}>

<script>
  (function() {
    class ColorVariantSwatches{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.productCard = null;
        this.productLink = null;
        this.productImage = null;
      }

      connectedCallback() {
        this.productCard = this.closest('.card-wrapper, .product-card-wrapper, .grid__item, [class*="product"]');
        
        if (this.productCard) {
          this.productLink = this.productCard.querySelector('a[href*="/products/"]');
          this.productImage = this.productCard.querySelector('img[class*="motion-reduce"], .card__media img, .media img');
        }

        this.swatches = this.querySelectorAll('.ai-color-swatches__swatch-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.swatches.forEach((swatch) => {
          swatch.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            this.handleSwatchClick(swatch);
          });
        });
      }

      handleSwatchClick(clickedSwatch) {
        this.swatches.forEach((swatch) => swatch.classList.remove('active'));
        clickedSwatch.classList.add('active');

        const variantUrl = clickedSwatch.dataset.variantUrl;
        const variantImage = clickedSwatch.dataset.variantImage;

        if (this.productLink && variantUrl) {
          this.productLink.href = variantUrl;
        }

        if (this.productImage && variantImage) {
          const imgSrcset = this.productImage.srcset;
          const imgSizes = this.productImage.sizes;
          
          this.productImage.src = variantImage;
          
          if (imgSrcset) {
            const baseUrl = variantImage.split('?')[0];
            this.productImage.srcset = imgSrcset.replace(/https:\/\/[^\s]+?\.(jpg|png|webp)/gi, baseUrl);
          }
        }
      }
    }

    customElements.define('color-variant-swatches-{{ ai_gen_id }}', ColorVariantSwatches{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Color variant swatches",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Swatch display"
    },
    {
      "type": "select",
      "id": "swatch_type",
      "label": "Swatch type",
      "options": [
        {
          "value": "image",
          "label": "Variant image"
        },
        {
          "value": "color",
          "label": "Color fill"
        }
      ],
      "default": "image",
      "info": "Variant image shows the product image for each color. Color fill shows a solid color circle."
    },
    {
      "type": "range",
      "id": "swatch_size",
      "label": "Swatch size",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "swatch_spacing",
      "label": "Spacing between swatches",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "Top spacing",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Swatch style"
    },
    {
      "type": "range",
      "id": "swatch_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 50,
      "info": "0% = square, 50% = circle"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Border thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "active_border_thickness",
      "label": "Active border thickness",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "color",
      "id": "active_border_color",
      "label": "Active border color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "hover_scale",
      "label": "Hover scale",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "default": 1.1
    }
  ],
  "presets": [
    {
      "name": "Color variant swatches"
    }
  ]
}
{% endschema %}