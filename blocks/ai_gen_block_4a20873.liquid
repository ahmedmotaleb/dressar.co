{% doc %}
  @prompt
    media grid contain 3 photo one lareg two small 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-media-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-media-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-media-grid-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-media-grid-item-{{ ai_gen_id }}--large {
    grid-row: 1 / 3;
    grid-column: 1 / 2;
  }

  .ai-media-grid-item-{{ ai_gen_id }}--small-1 {
    grid-row: 1 / 2;
    grid-column: 2 / 3;
  }

  .ai-media-grid-item-{{ ai_gen_id }}--small-2 {
    grid-row: 2 / 3;
    grid-column: 2 / 3;
  }

  .ai-media-grid-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-media-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 300px;
  }

  .ai-media-grid-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-media-grid-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-media-grid-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .ai-media-grid-item-{{ ai_gen_id }}--large {
      grid-row: 1 / 2;
      grid-column: 1 / 2;
    }

    .ai-media-grid-item-{{ ai_gen_id }}--small-1 {
      grid-row: 2 / 3;
      grid-column: 1 / 2;
    }

    .ai-media-grid-item-{{ ai_gen_id }}--small-2 {
      grid-row: 3 / 4;
      grid-column: 1 / 2;
    }

    .ai-media-grid-placeholder-{{ ai_gen_id }} {
      min-height: 200px;
    }
  }
{% endstyle %}

<media-grid-{{ ai_gen_id }} class="ai-media-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-media-grid-container-{{ ai_gen_id }}">
    <div class="ai-media-grid-item-{{ ai_gen_id }} ai-media-grid-item-{{ ai_gen_id }}--large">
      {% if block.settings.image_large %}
        <img
          src="{{ block.settings.image_large | image_url: width: 1200 }}"
          alt="{{ block.settings.image_large.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_large.width }}"
          height="{{ block.settings.image_large.height }}"
        >
      {% else %}
        <div class="ai-media-grid-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-media-grid-empty-state-{{ ai_gen_id }}">
            Add large image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-media-grid-item-{{ ai_gen_id }} ai-media-grid-item-{{ ai_gen_id }}--small-1">
      {% if block.settings.image_small_1 %}
        <img
          src="{{ block.settings.image_small_1 | image_url: width: 800 }}"
          alt="{{ block.settings.image_small_1.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_small_1.width }}"
          height="{{ block.settings.image_small_1.height }}"
        >
      {% else %}
        <div class="ai-media-grid-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-media-grid-empty-state-{{ ai_gen_id }}">
            Add small image 1
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-media-grid-item-{{ ai_gen_id }} ai-media-grid-item-{{ ai_gen_id }}--small-2">
      {% if block.settings.image_small_2 %}
        <img
          src="{{ block.settings.image_small_2 | image_url: width: 800 }}"
          alt="{{ block.settings.image_small_2.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_small_2.width }}"
          height="{{ block.settings.image_small_2.height }}"
        >
      {% else %}
        <div class="ai-media-grid-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-media-grid-empty-state-{{ ai_gen_id }}">
            Add small image 2
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</media-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class MediaGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('media-grid-{{ ai_gen_id }}', MediaGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Media grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_large",
      "label": "Large image"
    },
    {
      "type": "image_picker",
      "id": "image_small_1",
      "label": "Small image 1"
    },
    {
      "type": "image_picker",
      "id": "image_small_2",
      "label": "Small image 2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Media grid"
    }
  ]
}
{% endschema %}
