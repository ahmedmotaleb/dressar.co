{% doc %}
  @prompt
    media grid contain 3 photo one lareg two small 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-media-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-media-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-media-grid-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-media-grid-item-{{ ai_gen_id }}--large {
    grid-row: 1 / 3;
    grid-column: 1 / 2;
  }

  .ai-media-grid-item-{{ ai_gen_id }}--small-1 {
    grid-row: 1 / 2;
    grid-column: 2 / 3;
  }

  .ai-media-grid-item-{{ ai_gen_id }}--small-2 {
    grid-row: 2 / 3;
    grid-column: 2 / 3;
  }

  .ai-media-grid-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-media-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 300px;
  }

  .ai-media-grid-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-media-grid-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-media-grid-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .ai-media-grid-item-{{ ai_gen_id }}--large {
      grid-row: 1 / 2;
      grid-column: 1 / 2;
    }

    .ai-media-grid-item-{{ ai_gen_id }}--small-1 {
      grid-row: 2 / 3;
      grid-column: 1 / 2;
    }

    .ai-media-grid-item-{{ ai_gen_id }}--small-2 {
      grid-row: 3 / 4;
      grid-column: 1 / 2;
    }

    .ai-media-grid-placeholder-{{ ai_gen_id }} {
      min-height: 200px;
    }

    {%- if block.settings.mobile_mosaic != false %}
      /* Dressar: phone mosaic (docs/stages/mobile-spacing.md). The first image
         full width at 16:9, the other two side by side at 3:4; each image
         covers its frame around its focal point. */
      .ai-media-grid-container-{{ ai_gen_id }} {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: {{ block.settings.mobile_gap | default: 8 }}px;
        padding-inline: 16px;
        box-sizing: border-box;
      }

      .ai-media-grid-item-{{ ai_gen_id }} {
        border-radius: {{ block.settings.mobile_radius | default: 6 }}px;
      }

      .ai-media-grid-item-{{ ai_gen_id }}--large {
        grid-row: 1;
        grid-column: 1 / -1;
        aspect-ratio: 16 / 9;
      }

      .ai-media-grid-item-{{ ai_gen_id }}--small-1,
      .ai-media-grid-item-{{ ai_gen_id }}--small-2 {
        grid-row: 2;
        aspect-ratio: 3 / 4;
      }

      .ai-media-grid-item-{{ ai_gen_id }}--small-1 {
        grid-column: 1;
      }

      .ai-media-grid-item-{{ ai_gen_id }}--small-2 {
        grid-column: 2;
      }

      .ai-media-grid-item-{{ ai_gen_id }} img,
      .ai-media-grid-item-{{ ai_gen_id }} .ai-media-grid-placeholder-{{ ai_gen_id }} {
        position: absolute;
        inset: 0;
        min-height: 0;
      }
    {%- endif %}
  }
{% endstyle %}

<media-grid-{{ ai_gen_id }} class="ai-media-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-media-grid-container-{{ ai_gen_id }}">
    <div class="ai-media-grid-item-{{ ai_gen_id }} ai-media-grid-item-{{ ai_gen_id }}--large">
      {% if block.settings.image_large %}
        {%- liquid
          assign dsr_image = block.settings.image_large
          assign dsr_position = dsr_image.presentation.focal_point | default: 'center center'
          capture dsr_style
            echo 'object-position: ' | append: dsr_position | append: ';'
          endcapture
        -%}
        {{
          dsr_image
          | image_url: width: 1500
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 960, 1200, 1500',
            sizes: '(min-width: 750px) 50vw, 100vw',
            style: dsr_style
        }}
      {% else %}
        <div class="ai-media-grid-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-media-grid-empty-state-{{ ai_gen_id }}">
            Add large image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-media-grid-item-{{ ai_gen_id }} ai-media-grid-item-{{ ai_gen_id }}--small-1">
      {% if block.settings.image_small_1 %}
        {%- liquid
          assign dsr_image = block.settings.image_small_1
          assign dsr_position = dsr_image.presentation.focal_point | default: 'center center'
          capture dsr_style
            echo 'object-position: ' | append: dsr_position | append: ';'
          endcapture
        -%}
        {{
          dsr_image
          | image_url: width: 1500
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 960, 1200, 1500',
            sizes: '(min-width: 750px) 50vw, 50vw',
            style: dsr_style
        }}
      {% else %}
        <div class="ai-media-grid-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-media-grid-empty-state-{{ ai_gen_id }}">
            Add small image 1
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-media-grid-item-{{ ai_gen_id }} ai-media-grid-item-{{ ai_gen_id }}--small-2">
      {% if block.settings.image_small_2 %}
        {%- liquid
          assign dsr_image = block.settings.image_small_2
          assign dsr_position = dsr_image.presentation.focal_point | default: 'center center'
          capture dsr_style
            echo 'object-position: ' | append: dsr_position | append: ';'
          endcapture
        -%}
        {{
          dsr_image
          | image_url: width: 1500
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 960, 1200, 1500',
            sizes: '(min-width: 750px) 50vw, 50vw',
            style: dsr_style
        }}
      {% else %}
        <div class="ai-media-grid-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-media-grid-empty-state-{{ ai_gen_id }}">
            Add small image 2
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</media-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class MediaGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('media-grid-{{ ai_gen_id }}', MediaGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Media grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_large",
      "label": "Large image"
    },
    {
      "type": "image_picker",
      "id": "image_small_1",
      "label": "Small image 1"
    },
    {
      "type": "image_picker",
      "id": "image_small_2",
      "label": "Small image 2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile",
      "info": "Below 750px. Desktop keeps the layout above."
    },
    {
      "type": "checkbox",
      "id": "mobile_mosaic",
      "label": "Mosaic on phones",
      "info": "Large image full width (16:9), the two small images side by side (3:4). Off: the images stack.",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Gap between images, mobile",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "mobile_radius",
      "label": "Corner radius, mobile",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Media grid"
    }
  ]
}
{% endschema %}
