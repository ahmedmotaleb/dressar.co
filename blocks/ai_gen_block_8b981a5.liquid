{% doc %}
  @prompt
    Add color variant swatches displayed under every product card in the product grid and collection pages. Each swatch should show a small colored circle for each available color variant of the product. Clicking a swatch should update the product card to reflect that color variant (image and link). Only show color swatches, not other variant types like size.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-color-swatches-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-color-swatches-container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.swatch_spacing }}px;
    margin-top: {{ block.settings.top_spacing }}px;
    justify-content: {{ block.settings.alignment }};
  }

  .ai-color-swatch-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.swatch_size }}px;
    height: {{ block.settings.swatch_size }}px;
    border-radius: {{ block.settings.swatch_border_radius }}px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ai-color-swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-color-swatch-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.active_border_color }};
    border-width: {{ block.settings.active_border_thickness }}px;
    box-shadow: 0 0 0 1px {{ block.settings.active_border_color }};
  }

  .ai-color-swatch-inner-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: var(--swatch-color);
    background-image: var(--swatch-image);
    background-size: cover;
    background-position: center;
  }

  .ai-color-swatch-{{ ai_gen_id }}[data-color="white"] .ai-color-swatch-inner-{{ ai_gen_id }},
  .ai-color-swatch-{{ ai_gen_id }}[data-color="White"] .ai-color-swatch-inner-{{ ai_gen_id }} {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
  }

  @media screen and (max-width: 749px) {
    .ai-color-swatches-container-{{ ai_gen_id }} {
      gap: {{ block.settings.swatch_spacing | times: 0.8 }}px;
    }

    .ai-color-swatch-{{ ai_gen_id }} {
      width: {{ block.settings.swatch_size | times: 0.9 }}px;
      height: {{ block.settings.swatch_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<color-variant-swatches-{{ ai_gen_id }}
  class="ai-color-swatches-{{ ai_gen_id }}"
  data-product-id="{{ product.id }}"
  data-current-variant-id="{{ product.selected_or_first_available_variant.id }}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign color_option_index = nil
    for option in product.options_with_values
      assign option_name_downcase = option.name | downcase
      if option_name_downcase contains 'color' or option_name_downcase contains 'colour'
        assign color_option_index = option.position
        break
      endif
    endfor
  %}

  {% if color_option_index %}
    <div class="ai-color-swatches-container-{{ ai_gen_id }}">
      {% liquid
        assign color_values = product.options_with_values[color_option_index].values
        assign processed_colors = ''
      %}

      {% for color_value in color_values %}
        {% liquid
          assign color_key = color_value | handle
          if processed_colors contains color_key
            continue
          endif
          assign processed_colors = processed_colors | append: color_key | append: ','

          assign variant_for_color = nil
          for variant in product.variants
            if color_option_index == 1
              assign variant_color = variant.option1
            elsif color_option_index == 2
              assign variant_color = variant.option2
            else
              assign variant_color = variant.option3
            endif

            if variant_color == color_value
              assign variant_for_color = variant
              break
            endif
          endfor

          if variant_for_color == nil
            continue
          endif

          assign color_name_handle = color_value | handle
          assign color_file_name = color_name_handle | append: '.png'
          assign swatch_image = color_file_name | file_img_url: '50x50' | prepend: 'https:'

          assign is_active = false
          if product.selected_or_first_available_variant.id == variant_for_color.id
            assign is_active = true
          endif
        %}

        <button
          type="button"
          class="ai-color-swatch-{{ ai_gen_id }} {% if is_active %}active{% endif %}"
          data-variant-id="{{ variant_for_color.id }}"
          data-variant-url="{{ variant_for_color.url }}"
          data-variant-image="{% if variant_for_color.featured_image %}{{ variant_for_color.featured_image | image_url: width: 600 }}{% endif %}"
          data-color="{{ color_value }}"
          aria-label="{{ color_value }}"
          title="{{ color_value }}"
        >
          <span
            class="ai-color-swatch-inner-{{ ai_gen_id }}"
            style="
              --swatch-color: {{ color_value | handle | replace: '-', '' }};
              {% if block.settings.use_variant_images and variant_for_color.featured_image %}
                --swatch-image: url('{{ variant_for_color.featured_image | image_url: width: 100 }}');
              {% else %}
                --swatch-image: url('{{ swatch_image }}');
              {% endif %}
            "
          ></span>
        </button>
      {% endfor %}
    </div>
  {% endif %}
</color-variant-swatches-{{ ai_gen_id }}>

<script>
  (function() {
    class ColorVariantSwatches{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.swatches = this.querySelectorAll('.ai-color-swatch-{{ ai_gen_id }}');
        this.productCard = this.closest('.card-wrapper, .product-card, .grid__item, [data-product-card]');
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.swatches.forEach((swatch) => {
          swatch.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            this.handleSwatchClick(swatch);
          });
        });
      }

      handleSwatchClick(clickedSwatch) {
        const variantId = clickedSwatch.dataset.variantId;
        const variantUrl = clickedSwatch.dataset.variantUrl;
        const variantImage = clickedSwatch.dataset.variantImage;

        this.swatches.forEach((swatch) => {
          swatch.classList.remove('active');
        });
        clickedSwatch.classList.add('active');

        if (this.productCard) {
          const productLink = this.productCard.querySelector('a[href*="/products/"]');
          if (productLink && variantUrl) {
            productLink.href = variantUrl;
          }

          if (variantImage) {
            const productImage = this.productCard.querySelector('.card__media img, .media img, img[srcset]');
            if (productImage) {
              const newSrcset = variantImage.replace('.jpg', '_{width}x.jpg').replace('.png', '_{width}x.png');
              if (productImage.hasAttribute('srcset')) {
                productImage.srcset = newSrcset;
              }
              productImage.src = variantImage;
            }
          }
        }

        this.dataset.currentVariantId = variantId;
      }
    }

    customElements.define('color-variant-swatches-{{ ai_gen_id }}', ColorVariantSwatches{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Color variant swatches",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Swatch style"
    },
    {
      "type": "range",
      "id": "swatch_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Swatch size",
      "default": 24
    },
    {
      "type": "range",
      "id": "swatch_spacing",
      "min": 4,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Spacing between swatches",
      "default": 6
    },
    {
      "type": "range",
      "id": "swatch_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "use_variant_images",
      "label": "Use variant images in swatches",
      "info": "Show the variant's featured image inside the swatch instead of a color",
      "default": false
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "active_border_thickness",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Active border thickness",
      "default": 2
    },
    {
      "type": "color",
      "id": "active_border_color",
      "label": "Active border color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "top_spacing",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Top spacing",
      "default": 8
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Color variant swatches"
    }
  ]
}
{% endschema %}
