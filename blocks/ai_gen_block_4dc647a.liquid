{% doc %}
  @prompt
    RECENT VIEWED PRODUCTS
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recent-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-recent-products__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-recent-products__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-recent-products__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-recent-products__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-recent-products__grid-{{ ai_gen_id }}.loaded {
    opacity: 1;
  }

  .ai-recent-products__card-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-recent-products__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-recent-products__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background: #f4f4f4;
  }

  .ai-recent-products__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-recent-products__info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-recent-products__vendor-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.vendor_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .ai-recent-products__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 500;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-recent-products__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
  }

  .ai-recent-products__compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size | minus: 2 }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    margin-left: 8px;
  }

  .ai-recent-products__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 12px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-recent-products__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 16px;
  }

  .ai-recent-products__link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  @media screen and (max-width: 989px) {
    .ai-recent-products__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.products_per_row_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-recent-products__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.products_per_row_mobile }}, 1fr);
    }

    .ai-recent-products__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<recently-viewed-products-{{ ai_gen_id }}
  class="ai-recent-products-{{ ai_gen_id }}"
  data-current-product="{{ product.id }}"
  data-max-products="{{ block.settings.max_products }}"
  data-show-vendor="{{ block.settings.show_vendor }}"
  data-show-sale-badge="{{ block.settings.show_sale_badge }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-recent-products__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-recent-products__header-{{ ai_gen_id }}">
        <h2 class="ai-recent-products__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="ai-recent-products__grid-{{ ai_gen_id }}" id="ai-recent-grid-{{ ai_gen_id }}">
      <div class="ai-recent-products__empty-{{ ai_gen_id }}">
        {{ block.settings.empty_message }}
      </div>
    </div>
  </div>
</recently-viewed-products-{{ ai_gen_id }}>

<script>
  (function() {
    class RecentlyViewedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.storageKey = 'recentlyViewedProducts';
        this.currentProductId = this.dataset.currentProduct;
        this.maxProducts = parseInt(this.dataset.maxProducts) || 4;
        this.showVendor = this.dataset.showVendor === 'true';
        this.showSaleBadge = this.dataset.showSaleBadge === 'true';
        this.gridElement = this.querySelector('#ai-recent-grid-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.saveCurrentProduct();
        this.loadRecentProducts();
      }

      saveCurrentProduct() {
        if (!this.currentProductId) return;

        let recentProducts = this.getRecentProducts();
        recentProducts = recentProducts.filter(id => id !== this.currentProductId);
        recentProducts.unshift(this.currentProductId);
        recentProducts = recentProducts.slice(0, 20);

        try {
          localStorage.setItem(this.storageKey, JSON.stringify(recentProducts));
        } catch (e) {
          console.error('Failed to save to localStorage:', e);
        }
      }

      getRecentProducts() {
        try {
          const stored = localStorage.getItem(this.storageKey);
          return stored ? JSON.parse(stored) : [];
        } catch (e) {
          console.error('Failed to read from localStorage:', e);
          return [];
        }
      }

      async loadRecentProducts() {
        let recentProducts = this.getRecentProducts();
        recentProducts = recentProducts.filter(id => id !== this.currentProductId);
        recentProducts = recentProducts.slice(0, this.maxProducts);

        if (recentProducts.length === 0) {
          return;
        }

        try {
          const productData = await this.fetchProducts(recentProducts);
          this.renderProducts(productData);
        } catch (e) {
          console.error('Failed to load recent products:', e);
        }
      }

      async fetchProducts(productIds) {
        const promises = productIds.map(id =>
          fetch(`/products.json?limit=250`)
            .then(res => res.json())
            .then(data => data.products.find(p => p.id.toString() === id.toString()))
        );

        const products = await Promise.all(promises);
        return products.filter(p => p !== undefined);
      }

      renderProducts(products) {
        if (products.length === 0) {
          return;
        }

        this.gridElement.innerHTML = products.map(product => this.createProductCard(product)).join('');
        this.gridElement.classList.add('loaded');
      }

      createProductCard(product) {
        const variant = product.variants[0];
        const price = this.formatMoney(variant.price);
        const comparePrice = variant.compare_at_price ? this.formatMoney(variant.compare_at_price) : null;
        const onSale = variant.compare_at_price && variant.compare_at_price > variant.price;
        const imageUrl = product.images[0] ? product.images[0] : '';

        return `
          <div class="ai-recent-products__card-{{ ai_gen_id }}">
            <a href="/products/${product.handle}" class="ai-recent-products__link-{{ ai_gen_id }}">
              <div class="ai-recent-products__image-wrapper-{{ ai_gen_id }}">
                ${imageUrl ? `<img src="${imageUrl}" alt="${this.escapeHtml(product.title)}" class="ai-recent-products__image-{{ ai_gen_id }}" loading="lazy">` : ''}
                ${this.showSaleBadge && onSale ? `<div class="ai-recent-products__badge-{{ ai_gen_id }}">Sale</div>` : ''}
              </div>
              <div class="ai-recent-products__info-{{ ai_gen_id }}">
                ${this.showVendor && product.vendor ? `<div class="ai-recent-products__vendor-{{ ai_gen_id }}">${this.escapeHtml(product.vendor)}</div>` : ''}
                <h3 class="ai-recent-products__product-title-{{ ai_gen_id }}">${this.escapeHtml(product.title)}</h3>
                <div class="ai-recent-products__price-{{ ai_gen_id }}">
                  ${price}
                  ${comparePrice ? `<span class="ai-recent-products__compare-price-{{ ai_gen_id }}">${comparePrice}</span>` : ''}
                </div>
              </div>
            </a>
          </div>
        `;
      }

      formatMoney(cents) {
        const amount = (cents / 100).toFixed(2);
        return `EGP ${amount}`;
      }

      escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }
    }

    customElements.define('recently-viewed-products-{{ ai_gen_id }}', RecentlyViewedProducts{{ ai_gen_id }});
  })();
</script>

