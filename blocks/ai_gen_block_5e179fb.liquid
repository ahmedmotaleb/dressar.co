{% doc %}
  @prompt
    multiple videos beside each othe , add headline for video all, remove name of videso and add fit to area , add as media grid , MAKE A PLACE OF VIDEOS ADJUSTED AND NO BLACK SPACE UNDER ANY VIDEO AND EVERY VIDEOS ID EQUAL TO OTHER 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-video-gallery__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_font_size }}px;
    color: {{ block.settings.headline_color }};
    text-align: {{ block.settings.headline_alignment }};
    margin-bottom: {{ block.settings.headline_spacing }}px;
    font-weight: 600;
  }

  .ai-video-gallery__grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.video_gap }}px;
    width: 100%;
    grid-auto-rows: 1fr;
  }

  .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="standard"] {
    grid-template-columns: repeat({{ block.settings.videos_per_row }}, 1fr);
  }

  .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="masonry"] {
    grid-template-columns: repeat({{ block.settings.videos_per_row }}, 1fr);
    grid-auto-rows: minmax(250px, auto);
  }

  .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="featured"] {
    grid-template-columns: repeat(4, 1fr);
  }

  .ai-video-gallery__item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.video_border_radius }}px;
    background-color: {{ block.settings.video_background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="standard"] .ai-video-gallery__item-{{ ai_gen_id }} {
    aspect-ratio: 16 / 9;
  }

  .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="masonry"] .ai-video-gallery__item-{{ ai_gen_id }}:nth-child(1) {
    grid-row: span 2;
  }

  .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="masonry"] .ai-video-gallery__item-{{ ai_gen_id }}:nth-child(4) {
    grid-row: span 2;
  }

  .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="featured"] .ai-video-gallery__item-{{ ai_gen_id }}:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }

  .ai-video-gallery__video-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-video-gallery__video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.video_fit }};
    display: block;
  }

  .ai-video-gallery__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-video-gallery__placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="standard"],
    .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="masonry"],
    .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="featured"] {
      grid-template-columns: repeat({{ block.settings.videos_per_row_mobile }}, 1fr);
      grid-auto-rows: 1fr;
    }

    .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="masonry"] .ai-video-gallery__item-{{ ai_gen_id }},
    .ai-video-gallery__grid-{{ ai_gen_id }}[data-layout="featured"] .ai-video-gallery__item-{{ ai_gen_id }} {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: 16 / 9;
    }

    .ai-video-gallery__headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_font_size }}px * 0.8);
    }
  }
{% endstyle %}

<video-gallery-{{ ai_gen_id }}
  class="ai-video-gallery-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.headline != blank %}
    <h2 class="ai-video-gallery__headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
  {% endif %}

  <div class="ai-video-gallery__grid-{{ ai_gen_id }}" data-layout="{{ block.settings.grid_layout }}">
    {% for i in (1..6) %}
      {% liquid
        assign video_key = 'video_' | append: i
        assign video = block.settings[video_key]
      %}

      {% if video != blank %}
        <div class="ai-video-gallery__item-{{ ai_gen_id }}">
          <div class="ai-video-gallery__video-wrapper-{{ ai_gen_id }}">
            {{
              video
              | video_tag:
                image_size: '1100x',
                autoplay: block.settings.autoplay,
                loop: block.settings.loop,
                controls: block.settings.show_controls,
                muted: block.settings.muted,
                class: 'ai-video-gallery__video-' | append: ai_gen_id
            }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</video-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.videos = this.querySelectorAll('.ai-video-gallery__video-{{ ai_gen_id }}');
        this.setupVideoObserver();
      }

      setupVideoObserver() {
        if ('IntersectionObserver' in window) {
          const options = {
            root: null,
            rootMargin: '0px',
            threshold: 0.5
          };

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                if (entry.target.paused) {
                  entry.target.play().catch(() => {});
                }
              } else {
                if (!entry.target.paused) {
                  entry.target.pause();
                }
              }
            });
          }, options);

          this.videos.forEach((video) => {
            observer.observe(video);
          });
        }
      }
    }

    customElements.define('video-gallery-{{ ai_gen_id }}', VideoGallery{{ ai_gen_id }});
  })();
</script>

