{% doc %}
  @prompt
    IMAGE , INCLUDED IN FOOTER
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-content-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-footer-content-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-footer-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.spacing | divided_by: 2 }}px 0;
    color: currentColor;
  }

  .ai-footer-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
    color: currentColor;
  }

  .ai-footer-text-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.spacing | divided_by: 2 }}px 0;
  }

  .ai-footer-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-footer-links-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.link_spacing }}px;
  }

  .ai-footer-link-{{ ai_gen_id }} {
    color: currentColor;
    text-decoration: none;
    font-size: {{ block.settings.text_size }}px;
    transition: opacity 0.2s ease;
  }

  .ai-footer-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-footer-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-content-wrapper-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
    {% endif %}

    {% if block.settings.content_type == 'text' %}
      {% if block.settings.text != blank %}
        <div class="ai-footer-text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}
    {% elsif block.settings.content_type == 'links' %}
      <ul class="ai-footer-links-{{ ai_gen_id }}">
        {% if block.settings.link_1_text != blank and block.settings.link_1_url != blank %}
          <li>
            <a href="{{ block.settings.link_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">
              {{ block.settings.link_1_text }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.link_2_text != blank and block.settings.link_2_url != blank %}
          <li>
            <a href="{{ block.settings.link_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">
              {{ block.settings.link_2_text }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.link_3_text != blank and block.settings.link_3_url != blank %}
          <li>
            <a href="{{ block.settings.link_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">
              {{ block.settings.link_3_text }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.link_4_text != blank and block.settings.link_4_url != blank %}
          <li>
            <a href="{{ block.settings.link_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">
              {{ block.settings.link_4_text }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.link_5_text != blank and block.settings.link_5_url != blank %}
          <li>
            <a href="{{ block.settings.link_5_url }}" class="ai-footer-link-{{ ai_gen_id }}">
              {{ block.settings.link_5_text }}
            </a>
          </li>
        {% endif %}
      </ul>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Footer content",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quick links"
    },
    {
      "type": "select",
      "id": "content_type",
      "label": "Content type",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "links",
          "label": "Links"
        }
      ],
      "default": "links"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your custom text here</p>"
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "text",
      "id": "link_1_text",
      "label": "Link 1 text",
      "default": "About us"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Link 2 text",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "link_3_text",
      "label": "Link 3 text",
      "default": "Shipping policy"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "text",
      "id": "link_4_text",
      "label": "Link 4 text",
      "default": "Privacy policy"
    },
    {
      "type": "url",
      "id": "link_4_url",
      "label": "Link 4 URL"
    },
    {
      "type": "text",
      "id": "link_5_text",
      "label": "Link 5 text",
      "default": "Terms of service"
    },
    {
      "type": "url",
      "id": "link_5_url",
      "label": "Link 5 URL"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Section spacing",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "link_spacing",
      "label": "Link spacing",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Footer content"
    }
  ]
}
{% endschema %}