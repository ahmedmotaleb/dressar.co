{%- doc -%}
  The sold-out or sale badge of a product card (docs/stages/card-upgrade.md).

  The sale badge shows only the percentage ("38%"; screen readers hear
  "38% off"), worked out from one variant: the one whose price and compare-at
  price the card prints (card-product's price variant), so the badge always
  matches the prices beside it. (compare-at - price) / compare-at x 100,
  rounded to the nearest whole number; no badge without a real markdown.
  When the shopper picks another colour, assets/dsr-card.js moves the badge to
  that colour's price (it can appear, change or go): so a product with any
  variant on sale always gets the badge element, hidden when the shown
  variant isn't on sale.

  Dawn prints a card's badge twice (one copy for cards with media, one for
  cards without); both use this snippet so they can't disagree.

  @param {product} card_product - The product on the card.
  @param {variant} [variant] - The variant the card prices. Defaults to the product's first available variant.
  @param {string} id - The badge's ID, referenced by the card link's aria-labelledby.

  @example
  {% render 'dsr-card-badge', card_product: card_product, variant: dsr_price_variant, id: badge_id %}
{%- enddoc -%}

{%- liquid
  assign badge_variant = variant | default: card_product.selected_or_first_available_variant
  assign badge_percent = 0
  if badge_variant.compare_at_price > badge_variant.price
    assign badge_savings = badge_variant.compare_at_price | minus: badge_variant.price
    assign badge_percent = badge_savings | times: 100.0 | divided_by: badge_variant.compare_at_price | round
  endif
-%}

{%- if card_product.available == false -%}
  <span id="{{ id }}" class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}">
    {{- 'products.product.sold_out' | t -}}
  </span>
{%- elsif badge_percent >= 1 or card_product.compare_at_price_max > card_product.price_min -%}
  <span
    id="{{ id }}"
    class="badge badge--bottom-left dsr-sale-badge color-{{ settings.sale_badge_color_scheme }}"
    data-dsr-sale-badge
    {% if badge_percent < 1 %}
      hidden
    {% endif %}
  >
    {%- if badge_percent >= 1 -%}
      <span aria-hidden="true">{{ badge_percent }}%</span>
      <span class="visually-hidden">{{ 'dressar.card.sale_percent' | t: percent: badge_percent }}</span>
    {%- endif -%}
  </span>
{%- endif -%}
