{%- doc -%}
  The colour row of a product card: a fixed-height row (assets/dsr-card.css),
  on every card, so titles, prices, colours and sizes line up across the grid.
  Colours come only from Shopify's own data; nothing here maps colour names
  to hex codes.

  Where the colours come from, in order:
  1. The colour option's swatches: the colour or image set on each value of
     an option linked to the "Color" category metafield. One colour or
     several, each shown.
     - A swatch whose variant has its own photo is a button: it shows that
       photo on the card and points the card's links at the first in-stock
       variant in that colour (assets/dsr-card.js). The links carry
       `pick=color`, so the product page knows only the colour was chosen,
       not the size. Without a photo, a swatch is a plain, labelled dot.
     - A colour with no stock in any size is marked sold out.
  2. Otherwise, the product's "Color" category metafield
     (shopify.color-pattern), set by the merchant: the colour or image of
     each entry, as plain dots. This covers colour options not linked in
     Shopify.
  3. Otherwise, a colour option without swatch data (found by name: Theme
     settings > Dressar > "Colour option names") with several values shows
     a colour count.
  4. Otherwise (no colour data at all, e.g. a pattern with no colour or
     image): the row stays empty, at the same height. No made-up swatch.

  More colours than `limit`: `limit - 1` swatches and "+N", so the row never
  wraps.

  @param {product} card_product - The product on the card.
  @param {number} [limit] - The most items in the row, "+N" included. Defaults to 5.

  @example
  {% render 'dsr-card-swatches', card_product: card_product %}
{%- enddoc -%}

{%- liquid
  assign swatch_limit = limit | default: 5
  assign color_option = null
  assign color_has_swatches = false
  assign color_names = settings.card_color_option_names | downcase | split: ','

  for option in card_product.options_with_values
    for value in option.values
      if value.swatch
        assign color_option = option
        assign color_has_swatches = true
        break
      endif
    endfor
    if color_option
      break
    endif
  endfor

  unless color_option
    for option in card_product.options_with_values
      assign option_name = option.name | downcase | strip
      for name in color_names
        assign wanted = name | strip
        if wanted != blank and option_name == wanted
          assign color_option = option
          break
        endif
      endfor
      if color_option
        break
      endif
    endfor
  endunless

  # The merchant's Color category metafield: only entries with a colour or an image.
  assign meta_count = 0
  unless color_has_swatches
    for entry in card_product.metafields.shopify['color-pattern'].value
      if entry.image.value or entry.color.value
        assign meta_count = meta_count | plus: 1
      endif
    endfor
  endunless

  # One pass over the variants: the first in-stock variant of each colour,
  # kept as "|Black=123|Beige=456|".
  assign first_in_stock = '|'
  if color_has_swatches
    assign color_key = 'option' | append: color_option.position
    for variant in card_product.variants
      if variant.available
        assign marker = '|' | append: variant[color_key] | append: '='
        unless first_in_stock contains marker
          assign first_in_stock = first_in_stock | append: variant[color_key] | append: '=' | append: variant.id | append: '|'
        endunless
      endif
    endfor
  endif

  assign shown_limit = swatch_limit
  assign total = 0
  if color_has_swatches
    assign total = color_option.values.size
  elsif meta_count > 0
    assign total = meta_count
  endif
  if total > swatch_limit
    assign shown_limit = swatch_limit | minus: 1
  endif
  assign extra = total | minus: shown_limit
-%}

<div
  class="dsr-card-colors-row"
  {% if color_option %}
    data-option-index="{{ color_option.position | minus: 1 }}"
  {% endif %}
>
  {%- if color_has_swatches -%}
    {%- liquid
      assign featured_id = card_product.featured_media.id
      assign pressed_found = false
    -%}
    <dsr-card-swatches class="dsr-card-swatches">
      <ul class="dsr-card-swatches__list list-unstyled" role="list" aria-label="{{ 'dressar.card.colors_label' | t }}">
        {%- for value in color_option.values limit: shown_limit -%}
          {%- liquid
            assign media = value.variant.featured_media
            assign marker = '|' | append: value.name | append: '='
            assign variant_id = value.variant.id
            assign sold_out = true
            if first_in_stock contains marker
              assign variant_id = first_in_stock | split: marker | last | split: '|' | first
              assign sold_out = false
            endif
            assign label = value.name | escape
            if sold_out
              assign label = 'dressar.card.value_sold_out' | t: value: value.name
            endif
          -%}
          <li class="dsr-card-swatches__item">
            {%- if media and color_option.values.size > 1 -%}
              {%- liquid
                assign pressed = false
                if media.id == featured_id and pressed_found == false
                  assign pressed = true
                  assign pressed_found = true
                endif
              -%}
              <button
                type="button"
                class="dsr-card-swatch{% if sold_out %} dsr-card-swatch--sold-out{% endif %}"
                aria-label="{{ label }}"
                aria-pressed="{{ pressed }}"
                data-value="{{ value.name | escape }}"
                data-variant-id="{{ variant_id }}"
                data-src="{{ media | image_url: width: 533 }}"
                data-srcset="
                  {%- if media.width >= 165 -%}{{ media | image_url: width: 165 }} 165w,{%- endif -%}
                  {%- if media.width >= 360 -%}{{ media | image_url: width: 360 }} 360w,{%- endif -%}
                  {%- if media.width >= 533 -%}{{ media | image_url: width: 533 }} 533w,{%- endif -%}
                  {%- if media.width >= 720 -%}{{ media | image_url: width: 720 }} 720w,{%- endif -%}
                  {%- if media.width >= 940 -%}{{ media | image_url: width: 940 }} 940w,{%- endif -%}
                  {{ media | image_url }} {{ media.width }}w
                "
                data-alt="{{ media.alt | escape }}"
              >
                {%- render 'swatch', swatch: value.swatch -%}
              </button>
            {%- else -%}
              <span
                class="dsr-card-swatch dsr-card-swatch--static{% if sold_out %} dsr-card-swatch--sold-out{% endif %}"
                role="img"
                aria-label="{{ label }}"
                data-value="{{ value.name | escape }}"
              >
                {%- render 'swatch', swatch: value.swatch -%}
              </span>
            {%- endif -%}
          </li>
        {%- endfor -%}
        {%- if extra > 0 -%}
          <li class="dsr-card-swatches__more">
            <span aria-hidden="true">+{{ extra }}</span>
            <span class="visually-hidden">{{ 'dressar.card.more_colors' | t: count: extra }}</span>
          </li>
        {%- endif -%}
      </ul>
    </dsr-card-swatches>
  {%- elsif meta_count > 0 -%}
    <ul class="dsr-card-swatches__list list-unstyled" role="list" aria-label="{{ 'dressar.card.colors_label' | t }}">
      {%- assign meta_shown = 0 -%}
      {%- for entry in card_product.metafields.shopify['color-pattern'].value -%}
        {%- liquid
          unless entry.image.value or entry.color.value
            continue
          endunless
          if meta_shown >= shown_limit
            break
          endif
          assign meta_shown = meta_shown | plus: 1
          if entry.image.value
            assign meta_url = entry.image.value | image_url: width: 50
            assign meta_background = 'url(' | append: meta_url | append: ')'
          else
            assign meta_background = 'rgb(' | append: entry.color.value.rgb | append: ')'
          endif
        -%}
        <li class="dsr-card-swatches__item">
          <span class="dsr-card-swatch dsr-card-swatch--static" role="img" aria-label="{{ entry.label.value | escape }}">
            <span class="swatch" style="--swatch--background: {{ meta_background }};"></span>
          </span>
        </li>
      {%- endfor -%}
      {%- if extra > 0 -%}
        <li class="dsr-card-swatches__more">
          <span aria-hidden="true">+{{ extra }}</span>
          <span class="visually-hidden">{{ 'dressar.card.more_colors' | t: count: extra }}</span>
        </li>
      {%- endif -%}
    </ul>
  {%- elsif color_option and color_option.values.size > 1 -%}
    <p class="dsr-card-colors">{{ 'dressar.card.colors_count' | t: count: color_option.values.size }}</p>
  {%- endif -%}
</div>
