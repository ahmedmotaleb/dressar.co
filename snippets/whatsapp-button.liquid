{%- comment -%}
  ============================================================
  زرار واتساب عائم — Dressar
  بيظهر في كل صفحات الموقع. من غير جافاسكريبت ومن غير أي أب.

  الاستدعاء موجود في layout/theme.liquid قبل </body> مباشرة.
  الرقم والمكان من: Theme settings > Dressar > WhatsApp
  الكلام من ملفات اللغة: dressar.whatsapp.*
  ============================================================
{%- endcomment -%}

{%- liquid
  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign wa_side = settings.whatsapp_button_position | default: 'right'
  assign wa_label = 'dressar.whatsapp.label' | t
-%}

{%- capture wa_text -%}
{%- if template.name == 'product' and product != blank -%}
{{ 'dressar.whatsapp.message_product' | t: title: product.title }}
{{ shop.url }}{{ product.url }}
{%- else -%}
{{ 'dressar.whatsapp.message_general' | t: shop: shop.name }}
{%- endif -%}
{%- endcapture -%}

<a
  class="dsr-wa dsr-wa--{{ wa_side }}"
  href="https://wa.me/{{ wa_number }}?text={{ wa_text | strip | url_encode }}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="{{ wa_label | escape }}"
  title="{{ wa_label | escape }}"
>
  <svg class="dsr-wa__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
  </svg>
</a>
{%- style -%}
  .dsr-wa{
    position: fixed;
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    z-index: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: #25d366;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 6px 18px rgb(0 0 0 / 22%);
    transition: transform .18s ease, box-shadow .18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .dsr-wa--right{ right: 20px; }
  .dsr-wa--left{ left: 20px; }

  .dsr-wa__icon{ display: block; width: 60%; height: 60%; }

  .dsr-wa:hover,
  .dsr-wa:focus-visible{
    color: #fff;
    transform: scale(1.06);
    box-shadow: 0 10px 24px rgb(0 0 0 / 28%);
  }
  .dsr-wa:focus-visible{ outline: 3px solid #fff; outline-offset: 3px; }

  .dsr-wa::after{
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #25d366;
    animation: dsr-wa-pulse 2.4s ease-out infinite;
    pointer-events: none;
  }
  @keyframes dsr-wa-pulse{
    0%   { transform: scale(1);    opacity: .6; }
    70%  { transform: scale(1.55); opacity: 0; }
    100% { transform: scale(1.55); opacity: 0; }
  }

  @media screen and (max-width: 749px){
    .dsr-wa{
      width: 50px;
      height: 50px;
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    }
    .dsr-wa--right{ right: 16px; }
    .dsr-wa--left{ left: 16px; }
  }

  @media (prefers-reduced-motion: reduce){
    .dsr-wa{ transition: none; }
    .dsr-wa:hover{ transform: none; }
    .dsr-wa::after{ display: none; animation: none; }
  }
  @media print{ .dsr-wa{ display: none; } }
{%- endstyle -%}

