{%- doc -%}
  The rating of a product card, beside its price: a star, the score and the
  number of reviews, from the product's review metafields (reviews.rating and
  reviews.rating_count), which Judge.me keeps in sync with its reviews. Real
  reviews only: a product with none renders nothing (the price line keeps its
  height, so cards still line up).

  @param {product} card_product - The product on the card.

  @example
  {%- render 'dsr-card-rating', card_product: card_product -%}
{%- enddoc -%}
{%- liquid
  # Shopify keeps the rating type's fields as text ("4.5", "5.0"), and Liquid
  # can't compare text with a number: both values become numbers here.
  assign review_rating = card_product.metafields.reviews.rating.value
  assign rating_number = review_rating.rating | plus: 0
  assign review_count = card_product.metafields.reviews.rating_count.value | plus: 0
-%}
{%- if review_rating != blank and rating_number > 0 -%}
  {%- comment -%}
    Compact (docs/stages/card-v2.md): one gold star, the score as Judge.me
    keeps it ("4.6") and the number of reviews, beside the price.
  {%- endcomment -%}
  <p
    class="dsr-card-rating"
    role="img"
    aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: review_rating.rating, rating_max: review_rating.scale_max }}{% if review_count > 0 %}, {{ review_count }} {{ 'accessibility.total_reviews' | t }}{% endif %}"
  >
    <span class="dsr-card-rating__star" aria-hidden="true">★</span>
    <span class="dsr-card-rating__value" aria-hidden="true">{{ review_rating.rating }}</span>
    {%- if review_count > 0 -%}
      <span class="dsr-card-rating__count" aria-hidden="true">({{ review_count }})</span>
    {%- endif -%}
  </p>
{%- endif -%}
