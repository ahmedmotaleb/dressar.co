{%- doc -%}
  The rating row of a product card: stars and the number of reviews, from the
  product's review metafields (reviews.rating and reviews.rating_count), which
  Judge.me keeps in sync with its reviews. Real reviews only: a product with
  none renders nothing, so its card has no rating row and no empty space.
  Stars use Dawn's rating styles (component-rating.css).

  @param {product} card_product - The product on the card.

  @example
  {%- render 'dsr-card-rating', card_product: card_product -%}
{%- enddoc -%}
{%- liquid
  # Shopify keeps the rating type's fields as text ("4.5", "5.0"), and Liquid
  # can't compare text with a number: both values become numbers here.
  assign review_rating = card_product.metafields.reviews.rating.value
  assign rating_number = review_rating.rating | plus: 0
  assign review_count = card_product.metafields.reviews.rating_count.value | plus: 0
-%}
{%- if review_rating != blank and rating_number > 0 -%}
  {%- liquid
    assign rating_decimal = 0
    assign decimal = rating_number | modulo: 1
    if decimal >= 0.3 and decimal <= 0.7
      assign rating_decimal = 0.5
    elsif decimal > 0.7
      assign rating_decimal = 1
    endif
  -%}
  <p class="dsr-card-rating">
    <span
      class="rating"
      role="img"
      aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: review_rating.rating, rating_max: review_rating.scale_max }}"
    >
      <span
        aria-hidden="true"
        class="rating-star"
        style="--rating: {{ rating_number | floor }}; --rating-max: {{ review_rating.scale_max | plus: 0 }}; --rating-decimal: {{ rating_decimal }};"
      ></span>
    </span>
    {%- if review_count > 0 -%}
      <span class="dsr-card-rating__count">
        <span aria-hidden="true">({{ review_count }})</span>
        <span class="visually-hidden">{{ review_count }} {{ 'accessibility.total_reviews' | t }}</span>
      </span>
    {%- endif -%}
  </p>
{%- endif -%}
