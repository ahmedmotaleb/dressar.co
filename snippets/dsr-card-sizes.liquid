{%- doc -%}
  The size row of a product card: the product's own sizes, in its option
  order, as small buttons the shopper can choose (assets/dsr-card.js). The
  row is always there, one line high (assets/dsr-card.css), even when empty,
  so rows line up across the grid.

  - A size with no stock is struck through, announced as sold out and can't
    be chosen. Here, before a colour is chosen, that means no stock in any
    colour; assets/dsr-card.js then narrows it to the card's chosen colour.
  - A product with one size has it chosen already.
  - A sold-out product shows its sizes, all struck through.

  The size option is found by name: Theme settings > Dressar > "Size option
  names". One pass over the variants, no nested loops.

  @param {product} card_product - The product on the card.

  @example
  {% render 'dsr-card-sizes', card_product: card_product %}
{%- enddoc -%}

{%- liquid
  assign size_option = null
  assign size_names = settings.card_size_option_names | downcase | split: ','

  for option in card_product.options_with_values
    assign option_name = option.name | downcase | strip
    for name in size_names
      assign wanted = name | strip
      if wanted != blank and option_name == wanted
        assign size_option = option
        break
      endif
    endfor
    if size_option
      break
    endif
  endfor
-%}

<div
  class="dsr-card-sizes-row"
  {% if size_option %}
    data-option-index="{{ size_option.position | minus: 1 }}"
  {% endif %}
>
  {%- if size_option -%}
    {%- liquid
      assign size_key = 'option' | append: size_option.position
      assign in_stock = '|'
      for variant in card_product.variants
        if variant.available
          assign in_stock = in_stock | append: variant[size_key] | append: '|'
        endif
      endfor
      assign only_size = false
      if size_option.values.size == 1
        assign only_size = true
      endif
    -%}
    <ul class="dsr-card-sizes list-unstyled" role="list" aria-label="{{ 'dressar.card.sizes_label' | t }}">
      {%- for value in size_option.values -%}
        {%- liquid
          assign token = '|' | append: value.name | append: '|'
          assign size_sold_out = true
          if in_stock contains token
            assign size_sold_out = false
          endif
          assign sold_out_label = 'dressar.card.value_sold_out' | t: value: value.name
        -%}
        <li>
          <button
            type="button"
            class="dsr-card-size"
            data-value="{{ value.name | escape }}"
            data-sold-out-label="{{ sold_out_label | escape }}"
            aria-pressed="{% if only_size and size_sold_out == false %}true{% else %}false{% endif %}"
            {% if size_sold_out %}
              aria-disabled="true"
              aria-label="{{ sold_out_label | escape }}"
            {% endif %}
          >
            {{- value.name | escape -}}
          </button>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
