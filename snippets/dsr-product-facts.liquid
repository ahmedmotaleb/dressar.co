{%- doc -%}
  The product's fabric, fit, length, sleeves, neckline and care, read from
  Shopify's category metafields (Products > the product > Category
  metafields), shown as a collapsible row like Dawn's collapsible tabs.
  Only filled-in facts are listed, and nothing renders when none is: no
  default or made-up values.

  @param {product} product - The product.
  @param {string} heading - The row's heading (the block setting).
  @param {string} [icon] - The row's icon, as in Dawn's collapsible tabs (`icon-accordion`).
  @param {boolean} [open] - Whether the row starts open.
  @param {string} id - A unique ID for the row's content.

  @example
  {% render 'dsr-product-facts', product: product, heading: block.settings.heading, icon: block.settings.icon, open: block.settings.open, id: block.id %}
{%- enddoc -%}

{%- assign mf = product.metafields.shopify -%}
{%- comment -%} Category metafields are lists of taxonomy entries; each entry's `label` field holds its name. {%- endcomment -%}
{%- capture fabric -%}{%- for item in mf.fabric.value -%}{{ item.label.value }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- endcapture -%}
{%- capture fit -%}{%- for item in mf.fit.value -%}{{ item.label.value }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- endcapture -%}
{%- capture length -%}{%- for item in mf['skirt-dress-length-type'].value -%}{{ item.label.value }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- endcapture -%}
{%- if length == blank -%}
  {%- capture length -%}{%- for item in mf['top-length-type'].value -%}{{ item.label.value }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- endcapture -%}
{%- endif -%}
{%- if length == blank -%}
  {%- capture length -%}{%- for item in mf['pants-length-type'].value -%}{{ item.label.value }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- endcapture -%}
{%- endif -%}
{%- capture sleeve -%}{%- for item in mf['sleeve-length-type'].value -%}{{ item.label.value }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- endcapture -%}
{%- capture neckline -%}{%- for item in mf.neckline.value -%}{{ item.label.value }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- endcapture -%}
{%- capture care -%}{%- for item in mf['care-instructions'].value -%}{{ item.label.value }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- endcapture -%}

{%- if fabric != blank or fit != blank or length != blank or sleeve != blank or neckline != blank or care != blank -%}
  <div class="product__accordion accordion quick-add-hidden dsr-facts">
    <details id="Details-{{ id }}"{% if open %} open{% endif %}>
      <summary>
        <div class="summary__title">
          {% render 'icon-accordion', icon: icon %}
          <h2 class="h4 accordion__title inline-richtext">{{ heading | escape }}</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content" id="ProductAccordion-{{ id }}">
        <dl class="dsr-facts__list">
          {%- if fabric != blank -%}
            <div class="dsr-facts__row"><dt>{{ 'dressar.product.facts.fabric' | t }}</dt><dd>{{ fabric | escape }}</dd></div>
          {%- endif -%}
          {%- if fit != blank -%}
            <div class="dsr-facts__row"><dt>{{ 'dressar.product.facts.fit' | t }}</dt><dd>{{ fit | escape }}</dd></div>
          {%- endif -%}
          {%- if length != blank -%}
            <div class="dsr-facts__row"><dt>{{ 'dressar.product.facts.length' | t }}</dt><dd>{{ length | escape }}</dd></div>
          {%- endif -%}
          {%- if sleeve != blank -%}
            <div class="dsr-facts__row"><dt>{{ 'dressar.product.facts.sleeve' | t }}</dt><dd>{{ sleeve | escape }}</dd></div>
          {%- endif -%}
          {%- if neckline != blank -%}
            <div class="dsr-facts__row"><dt>{{ 'dressar.product.facts.neckline' | t }}</dt><dd>{{ neckline | escape }}</dd></div>
          {%- endif -%}
          {%- if care != blank -%}
            <div class="dsr-facts__row"><dt>{{ 'dressar.product.facts.care' | t }}</dt><dd>{{ care | escape }}</dd></div>
          {%- endif -%}
        </dl>
      </div>
    </details>
  </div>
{%- endif -%}
